# Copy to `.env` for local development. On Vercel these live in
# Project Settings → Environment Variables.
#
# None of these may be prefixed with PUBLIC_ — that would inline them into the
# browser bundle and leak the API key.

# Brevo → SMTP & API → API Keys. Free plan sends 300 emails/day.
BREVO_API_KEY=xkeysib-...
# Where new submissions are delivered — both the contact form and the intake
# questionnaire (/ankieta-startowa) use this same inbox.
CONTACT_NOTIFICATION_EMAIL=a.potocka.rozliczenia@gmail.com

# Sender identity. The address must be verified in Brevo
# (Senders → Add a sender → confirm the 6-digit code).
# Until a custom domain exists, Brevo rewrites a free @gmail.com sender to its
# own technical address and keeps this one as Reply-To.
CONTACT_SENDER_EMAIL=a.potocka.rozliczenia@gmail.com
CONTACT_SENDER_NAME=Aleksandra Potocka — Księgowość
