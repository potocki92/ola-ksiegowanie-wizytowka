---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileStickyCta from "../components/layout/MobileStickyCta.astro";
import Hero from "../components/sections/Hero.astro";
import ToolsStrip from "../components/sections/ToolsStrip.astro";
import ServicesSection from "../components/sections/services/ServicesSection.astro";
import ValueProps from "../components/sections/ValueProps.astro";
import AboutSection from "../components/sections/about/AboutSection.astro";
import Pricing from "../components/sections/Pricing.astro";
import Process from "../components/sections/Process.astro";
import Faq from "../components/sections/Faq.astro";
import ContactSection from "../components/sections/contact/ContactSection.astro";
import ForWhom from "../components/sections/ForWhom.astro";
import Testimonials from "../components/sections/Testimonials.astro";
import { faqs } from "../data/faq";

const faqPageNode = {
	"@type": "FAQPage",
	mainEntity: faqs.map((item) => ({
		"@type": "Question",
		name: item.q,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.a,
		},
	})),
};
---

<Layout extraJsonLd={[faqPageNode]}>
	<Header />
	<main>
		<Hero />
		<ToolsStrip />
		<ServicesSection />
		<ForWhom />
		<ValueProps />
		<AboutSection />
		<Pricing />
		<Process />
		<Faq />
		<Testimonials />
		<ContactSection />
	</main>
	<Footer />
	<MobileStickyCta />
</Layout>
