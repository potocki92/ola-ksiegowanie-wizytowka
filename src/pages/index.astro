---
import Layout from "../layouts/Layout.astro";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import MobileStickyCta from "../components/layout/MobileStickyCta.astro";
import Hero from "../components/sections/Hero.astro";
import ToolsStrip from "../components/sections/ToolsStrip.astro";
import ServicesSection from "../components/sections/services/ServicesSection.astro";
import ValueProps from "../components/sections/ValueProps.astro";
import AboutSection from "../components/sections/about/AboutSection.astro";
import Pricing from "../components/sections/Pricing.astro";
import ProcessSection from "../components/sections/process/ProcessSection.astro";
import Faq from "../components/sections/Faq.astro";
import ContactSection from "../components/sections/contact/ContactSection.astro";
---

<Layout>
	<Header />
	<main>
		<Hero />
		<ToolsStrip />
		<ServicesSection />
		<ValueProps />
		<AboutSection />
		<Pricing />
		<ProcessSection />
		<Faq />
		<ContactSection />
	</main>
	<Footer />
	<MobileStickyCta />
</Layout>
