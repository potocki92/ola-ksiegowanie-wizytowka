---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Aleksandra Potocka — Księgowość online dla jednoosobowych działalności",
	description = "Prowadzenie i zakładanie JDG, kadry i płace, rozliczenia VAT i ZUS — w pełni zdalnie, w całej Polsce. Bezpłatna pierwsza konsultacja.",
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "AccountingService",
	name: "Aleksandra Potocka — Księgowość",
	description,
	telephone: "+48533032455",
	email: "kontakt@potockaksiegowosc.pl",
	areaServed: "PL",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Jelenia Góra",
		addressCountry: "PL",
	},
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<body class="bg-bg relative">
		<!-- `overflow-x-hidden` żyje na tym wrapperze, NIE na <body>. Safari na
		     iOS liczy pozycję `position: sticky` względem `<body>` w specjalny
		     sposób powiązany z dynamicznym paskiem adresu — gdy `<body>` ma
		     nie-`visible` overflow, zmiana kierunku scrolla (co zwija/rozwija
		     pasek adresu) potrafi na klatkę zostawić navbar w złej pozycji i
		     odsłonić białą lukę pod nim. Przeniesienie overflow na wewnętrzny
		     div daje tę samą ochronę przed poziomym scrollem bez psucia sticky. -->
		<div class="max-w-full overflow-x-hidden">
			<slot />
		</div>
		<script>
			import "../lib/scrollReveal";
			// TYMCZASOWO WYŁĄCZONE — test diagnostyczny: sprawdzamy, czy ciągłe
			// aktualizowanie transformu przez parallax (rAF na każdej klatce
			// scrolla) jest przyczyną białego błysku pod navbarem na iOS Safari.
			// import "../lib/parallax";
		</script>
	</body>
</html>
