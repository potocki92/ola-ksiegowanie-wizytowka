---
import "../styles/global.css";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";

interface Props {
	title?: string;
	description?: string;
	/** Strony dostępne tylko na bezpośredni link (np. ankieta wysyłana klientom) nie mają trafiać do wyszukiwarek. */
	noindex?: boolean;
}

const {
	title = "Aleksandra Potocka — Księgowość online dla jednoosobowych działalności",
	description = "Prowadzenie i zakładanie JDG, kadry i płace, rozliczenia VAT i ZUS — w pełni zdalnie, w całej Polsce. Bezpłatna pierwsza konsultacja.",
	noindex = false,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url.pathname;

const jsonLd = {
	"@context": "https://schema.org",
	"@type": "AccountingService",
	name: "Aleksandra Potocka — Księgowość",
	description,
	telephone: "+48533032455",
	email: "kontakt@potockaksiegowosc.pl",
	areaServed: "PL",
	address: {
		"@type": "PostalAddress",
		addressLocality: "Jelenia Góra",
		addressCountry: "PL",
	},
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />

		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

		{/*
			Przejścia między trasami (`/`, polityka prywatności, ankieta) zamiast
			białego mrugnięcia przy każdym kliknięciu. Nawigacja nie przeładowuje
			dokumentu, więc moduły wykonują się tylko raz — każdy skrypt strony
			wchodzi przez `onPageInit` z lib/pageInit.ts, żeby po podmianie DOM
			podpiąć się na nowo. Astro samo respektuje `prefers-reduced-motion`.
		*/}
		<ClientRouter />
	</head>
	<!-- `overflow-x-hidden` musi zostać na <body>, nie na wewnętrznym
	     wrapperze: `position: sticky` liczy się względem najbliższego przodka
	     ze scrollowalnym boxem, a zwykły <div> z overflow innym niż `visible`
	     tworzy taki box bez własnego, realnego scrolla — sticky wtedy przestaje
	     działać w ogóle (potwierdzone: navbar przesuwał się razem z treścią
	     zamiast się przyklejać). <body> jest wyjątkiem: jego overflow mapuje
	     się na scroller viewportu, więc sticky działa normalnie. Biały błysk
	     pod navbarem na iOS Safari naprawia `html { background }` w
	     global.css — to nie miało związku z tym, gdzie leży overflow-x-hidden. -->
	<body class="max-w-full overflow-x-hidden bg-bg relative">
		<slot />
		<SpeedInsights />
		<script>
			import "../lib/scrollReveal";
			import "../lib/cardGlow";
			// Parallax nie ma już swojego modułu — robi go `animation-timeline: view()`
			// w global.css, czyli bez JS na wątku głównym. Patrz komentarz przy
			// sekcji „Animacje: parallax".
		</script>
	</body>
</html>
