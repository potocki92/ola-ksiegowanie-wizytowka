---
import "../styles/global.css";
import { pricing, getJdgPriceRangeLabel } from "../data/pricing";
import defaultOgImage from "../assets/og-image.png";

interface Props {
	title?: string;
	description?: string;
	/** Ścieżka do podmiany zamiast Astro.url.pathname — dla stron spoza standardowego routingu. */
	canonicalPath?: string;
	/** Ścieżka do obrazu OG (np. z public/) — domyślnie generyczny placeholder marki. */
	ogImage?: string;
	type?: "website" | "article";
	/** Dodatkowe węzły schema.org scalane z głównym węzłem przez @graph (np. FAQPage). */
	extraJsonLd?: Record<string, unknown>[];
}

const {
	title = "Aleksandra Potocka — Księgowość online dla jednoosobowych działalności",
	description = "Prowadzenie i zakładanie JDG, kadry i płace, rozliczenia VAT i ZUS — w pełni zdalnie, w całej Polsce. Bezpłatna pierwsza konsultacja.",
	canonicalPath,
	ogImage,
	type = "website",
	extraJsonLd = [],
} = Astro.props;

const canonicalURL = Astro.site
	? new URL(canonicalPath ?? Astro.url.pathname, Astro.site)
	: (canonicalPath ?? Astro.url.pathname);

const ogImagePath = ogImage ?? defaultOgImage.src;
const ogImageURL = Astro.site ? new URL(ogImagePath, Astro.site) : ogImagePath;

const accountingServiceNode = {
	"@type": "AccountingService",
	name: "Aleksandra Potocka — Księgowość",
	description,
	url: Astro.site ? Astro.site.toString() : undefined,
	telephone: "+48533032455",
	email: "kontakt@potockaksiegowosc.pl",
	logo: Astro.site ? new URL("/apple-touch-icon.png", Astro.site).toString() : "/apple-touch-icon.png",
	image: ogImageURL.toString(),
	areaServed: "PL",
	priceRange: getJdgPriceRangeLabel(pricing),
	address: {
		"@type": "PostalAddress",
		addressLocality: "Jelenia Góra",
		addressCountry: "PL",
	},
	hasOfferCatalog: {
		"@type": "OfferCatalog",
		name: "Usługi księgowe",
		itemListElement: [
			"Prowadzenie JDG",
			"Kadry i płace",
			"Zakładanie działalności",
			"Rozliczenia roczne PIT",
		].map((serviceName) => ({
			"@type": "Offer",
			itemOffered: { "@type": "Service", name: serviceName },
		})),
	},
};

const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [accountingServiceNode, ...extraJsonLd],
};
---

<!doctype html>
<html lang="pl">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<script is:inline>
			document.documentElement.classList.add("js");
		</script>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

		<title>{title}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:type" content={type} />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:site_name" content="Aleksandra Potocka — Księgowość" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />

		<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
	</head>
	<!-- `overflow-x-hidden` musi zostać na <body>, nie na wewnętrznym
	     wrapperze: `position: sticky` liczy się względem najbliższego przodka
	     ze scrollowalnym boxem, a zwykły <div> z overflow innym niż `visible`
	     tworzy taki box bez własnego, realnego scrolla — sticky wtedy przestaje
	     działać w ogóle (potwierdzone: navbar przesuwał się razem z treścią
	     zamiast się przyklejać). <body> jest wyjątkiem: jego overflow mapuje
	     się na scroller viewportu, więc sticky działa normalnie. Biały błysk
	     pod navbarem na iOS Safari naprawia `html { background }` w
	     global.css — to nie miało związku z tym, gdzie leży overflow-x-hidden. -->
	<body class="max-w-full overflow-x-hidden bg-bg relative">
		<slot />
		<Analytics />
		<script>
			import "../lib/scrollReveal";
			// TYMCZASOWO WYŁĄCZONE — test diagnostyczny: sprawdzamy, czy ciągłe
			// aktualizowanie transformu przez parallax (rAF na każdej klatce
			// scrolla) jest przyczyną białego błysku pod navbarem na iOS Safari.
			// import "../lib/parallax";
		</script>
	</body>
</html>
