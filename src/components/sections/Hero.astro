---
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import IconTile from "../ui/IconTile.astro";
import Image from "../ui/Image.astro";

const trustBadges = ["UE Wrocław", "6 lat praktyki", "100% online"];
---

<Section
	id="top"
	as="header"
	padding="none"
	class="px-[clamp(18px,4vw,56px)] pt-[clamp(40px,6vw,88px)] pb-[clamp(48px,6vw,80px)]"
	glow="bg-[radial-gradient(60%_50%_at_78%_8%,rgba(123,108,246,0.16),transparent_70%),radial-gradient(55%_45%_at_12%_4%,rgba(79,91,242,0.12),transparent_70%)]"
>
	<div
		class="flex flex-col items-center gap-9 md:grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:gap-[clamp(32px,4vw,64px)]"
	>
		<div class="order-1 animate-rise-in md:order-0">
			<h1
				class="text-[clamp(40px,6.4vw,80px)] leading-none tracking-[-0.035em]"
				style="text-wrap: balance;"
			>
				Księgowość od A do Z. <span
					class="bg-linear-to-r from-accent to-accent-3 bg-clip-text text-transparent"
					>Ty zawsze na pierwszym miejscu.</span
				>
			</h1>

			<p class="mt-[clamp(18px,2.4vw,26px)] max-w-[52ch] text-[clamp(16px,1.35vw,19px)] leading-[1.6] text-muted-600">
				Prowadzę jednoosobowe działalności gospodarcze na zasadach ogólnych, podatku liniowym i ryczałcie —
				w pełni zdalnie, terminowo i z realnym kontaktem. Bez papierologii, kolejek i stresu.
			</p>

			<div class="mt-[clamp(26px,3vw,38px)] flex flex-col flex-wrap gap-3 sm:flex-row">
				<Button href="#kontakt" variant="primary" size="lg">
					Umów bezpłatną konsultację
				</Button>
				<Button href="#cennik" variant="secondary" size="lg" class="px-6.5">
					Zobacz cennik
				</Button>
			</div>

			<div class="mt-[clamp(24px,3vw,34px)] flex flex-wrap gap-2">
				{
					trustBadges.map((badge, i) => (
						<>
							{i > 0 && <span class="h-4 w-px self-center bg-border-5" />}
							<span class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-muted-600">
								<Icon name="check" size={16} strokeWidth={2.4} class="text-success" />
								{badge}
							</span>
						</>
					))
				}
			</div>
		</div>

		<div class="relative order-2 w-full animate-rise-in-delayed md:order-0">
			<div
				class="relative aspect-4/5 overflow-hidden rounded-[28px] bg-linear-to-br from-[#EEF0FF] via-[#F5F6FB] to-[#E9EBFC] shadow-[0_40px_80px_-40px_rgba(11,11,18,0.45)] md:aspect-auto md:h-[clamp(420px,46vw,560px)]"
			>
				<Image
					src="/pszozena.png"
					alt="mgr Aleksandra Potocka – księgowa"
					width={800}
					height={1000}
					loading="eager"
					fetchpriority="high"
					class="h-full w-full object-cover object-center"
				/>

				<div
					class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-linear-to-t from-black/35 to-transparent"
				>
				</div>

				<div
					class="absolute right-4 bottom-4 left-4 flex items-center gap-3 rounded-2xl border border-white/60 bg-white/85 px-3.5 py-3 shadow-[0_18px_40px_-20px_rgba(11,11,18,0.5)] backdrop-blur-md sm:right-auto"
				>
					<span
						class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-linear-to-br from-accent to-accent-2 font-display text-[15px] font-extrabold text-white shadow-[0_8px_18px_-8px_rgba(79,91,242,0.8)]"
						>AP</span
					>
					<div>
						<div class="font-display text-[16px] font-extrabold tracking-[-0.02em] text-ink">
							mgr Aleksandra Potocka
						</div>
						<div class="mt-0.5 flex items-center gap-1.5 text-[13px] font-semibold text-muted-600">
							<span class="h-1.5 w-1.5 rounded-full bg-success"></span>
							Księgowa online
						</div>
					</div>
				</div>

				<div
					class="absolute top-4 right-4 hidden items-center gap-2.5 rounded-2xl bg-linear-to-br from-accent to-accent-2 px-3.5 py-2.5 text-white shadow-[0_18px_40px_-20px_rgba(79,91,242,0.8)] sm:flex"
				>
					<IconTile
						icon="calendar-check"
						size="h-9 w-9"
						bg="bg-white/18"
						iconClass="text-white"
						iconSize={18}
						iconStrokeWidth={1.9}
					/>
					<div class="text-[13.5px] font-bold">Terminy dopilnowane ✓</div>
				</div>
			</div>
		</div>
	</div>
</Section>
