---
import CheckItem from "../ui/CheckItem.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Image from "../ui/Image.astro";

const trustBadges = ["UE Wrocław", "6 lat praktyki", "100% online"];
---

<Section
	id="top"
	as="header"
	padding="none"
	class="px-[clamp(18px,4vw,56px)] pt-[clamp(40px,6vw,88px)] md:pb-[clamp(48px,6vw,80px)]"
	glow="bg-[radial-gradient(60%_50%_at_78%_8%,rgba(107,111,158,0.09),transparent_70%),radial-gradient(55%_45%_at_12%_4%,rgba(47,68,104,0.07),transparent_70%)]"
>
	<div
		class="flex flex-col items-center gap-9 md:grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:gap-[clamp(32px,4vw,64px)]"
	>
		<!-- Elementy wchodzą po kolei (`--seq` = miejsce w kolejce, 90 ms na krok),
		     a nie całą kolumną naraz — oko podąża wtedy tą samą drogą, którą
		     czyta: nagłówek, obietnica, akcja, dowód. -->
		<div class="order-1 md:order-0">
			<!-- Każde zdanie ma własny wiersz. Wcześniej oba leciały jednym
			     strumieniem i „Ty" lądowało w wierszu z „…od A do Z.". „od A do Z"
			     jest sklejone twardymi spacjami, bo to zwrot nierozdzielny. -->
			<h1
				class="text-[clamp(38px,5vw,58px)] leading-[1.06] tracking-[-0.035em] text-balance"
			>
				<span data-hero-item style="--seq:0" class="block">
					Księgowość od&nbsp;A&nbsp;do&nbsp;Z.
				</span>
				<span
					data-hero-item
					style="--seq:1"
					class="block bg-linear-to-r from-accent to-accent-3 bg-clip-text text-transparent"
				>
					Ty zawsze na pierwszym miejscu.
				</span>
			</h1>

			<p
				data-hero-item
				style="--seq:2"
				class="mt-[clamp(18px,2.4vw,26px)] max-w-[52ch] text-[clamp(16px,1.35vw,19px)] leading-[1.6] text-pretty text-muted-600"
			>
				Prowadzę jednoosobowe działalności gospodarcze na zasadach ogólnych, podatku liniowym
				i&nbsp;ryczałcie&nbsp;— w&nbsp;pełni zdalnie, terminowo i&nbsp;z&nbsp;realnym kontaktem.
				Bez papierologii, kolejek i&nbsp;stresu.
			</p>

			<div
				data-hero-item
				style="--seq:3"
				class="mt-[clamp(26px,3vw,38px)] flex flex-col flex-wrap gap-3 sm:flex-row"
			>
				<Button href="#kontakt" variant="primary" size="lg">
					Umów bezpłatną konsultację
				</Button>
				<Button href="#cennik" variant="secondary" size="lg" class="px-6.5">
					Zobacz cennik
				</Button>
			</div>

			<div data-hero-item style="--seq:4" class="mt-[clamp(24px,3vw,34px)] flex flex-wrap gap-2">
				{
					trustBadges.map((badge, i) => (
						<>
							{i > 0 && <span class="h-4 w-px self-center bg-border-5" />}
							<CheckItem
								tone="success"
								size={16}
								class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-muted-600"
							>
								{badge}
							</CheckItem>
						</>
					))
				}
			</div>
		</div>

		<div class="relative order-2 w-full md:order-0">
			<!-- Zdjęcie odsłania się maską od góry w dół. Przesuwanie kadru
			     (poprzednie `animate-rise-in-delayed`) przy portrecie widać jako
			     „skok obrazka"; ścieranie maski czyta się jak wywoływanie kliszy. -->
			<div
				data-hero-media
				class="relative aspect-4/5 overflow-hidden md:aspect-auto md:h-[clamp(440px,48vw,580px)]"
			>
				<div data-parallax class="absolute left-0 top-[-8%] h-[116%] w-full">
					<Image
						src="/portret.webp"
						alt="mgr Aleksandra Potocka – księgowa"
						width={1024}
						height={1536}
						loading="eager"
						fetchpriority="high"
						class="h-full w-full object-cover object-[center_22%]"
					/>
				</div>
			</div>
		</div>
	</div>
</Section>
