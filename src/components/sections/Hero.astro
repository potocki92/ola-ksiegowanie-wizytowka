---
import Icon from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import Button from "../ui/Button.astro";
import Image from "../ui/Image.astro";

const trustBadges = ["UE Wrocław", "6 lat praktyki", "100% online"];
---

<Section
	id="top"
	as="header"
	padding="none"
	class="px-[clamp(18px,4vw,56px)] pt-[clamp(40px,6vw,88px)] md:pb-[clamp(48px,6vw,80px)]"
	glow="bg-[radial-gradient(60%_50%_at_78%_8%,rgba(123,108,246,0.16),transparent_70%),radial-gradient(55%_45%_at_12%_4%,rgba(79,91,242,0.12),transparent_70%)]"
>
	<div
		class="flex flex-col items-center gap-9 md:grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:gap-[clamp(32px,4vw,64px)]"
	>
		<div class="order-1 animate-rise-in md:order-0">
			<h1
				class="text-[clamp(40px,6.4vw,80px)] leading-none tracking-[-0.035em]"
				style="text-wrap: balance;"
			>
				Księgowość od A do Z. <span
					class="bg-linear-to-r from-accent to-accent-3 bg-clip-text text-transparent"
					>Ty zawsze na pierwszym miejscu.</span
				>
			</h1>

			<p class="mt-[clamp(18px,2.4vw,26px)] max-w-[52ch] text-[clamp(16px,1.35vw,19px)] leading-[1.6] text-muted-600">
				Prowadzę jednoosobowe działalności gospodarcze na zasadach ogólnych, podatku liniowym i ryczałcie —
				w pełni zdalnie, terminowo i z realnym kontaktem. Bez papierologii, kolejek i stresu.
			</p>

			<div class="mt-[clamp(26px,3vw,38px)] flex flex-col flex-wrap gap-3 sm:flex-row">
				<Button href="#kontakt" variant="primary" size="lg">
					Umów bezpłatną konsultację
				</Button>
				<Button href="#cennik" variant="secondary" size="lg" class="px-6.5">
					Zobacz cennik
				</Button>
			</div>

			<div class="mt-[clamp(24px,3vw,34px)] flex flex-wrap gap-2">
				{
					trustBadges.map((badge, i) => (
						<>
							{i > 0 && <span class="h-4 w-px self-center bg-border-5" />}
							<span class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-muted-600">
								<Icon name="check" size={16} strokeWidth={2.4} class="text-success" />
								{badge}
							</span>
						</>
					))
				}
			</div>
		</div>

		<div class="relative order-2 w-full animate-rise-in-delayed md:order-0">
			<div
				class="relative aspect-4/5 overflow-hidden md:aspect-auto md:h-[clamp(440px,48vw,580px)]"
			>
				<Image
					src="/portret.webp"
					alt="mgr Aleksandra Potocka – księgowa"
					width={1024}
					height={1536}
					loading="eager"
					fetchpriority="high"
					class="h-full w-full object-cover object-[center_22%]"
				/>
			</div>
		</div>
	</div>
</Section>
