---
import Icon from "../ui/Icon.astro";

const trustBadges = ["UE Wrocław", "6 lat praktyki", "100% online"];
---

<header
	id="top"
	class="relative px-[clamp(18px,4vw,56px)] pt-[clamp(40px,6vw,88px)] pb-[clamp(48px,6vw,80px)]"
>
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(60%_50%_at_78%_8%,rgba(123,108,246,0.16),transparent_70%),radial-gradient(55%_45%_at_12%_4%,rgba(79,91,242,0.12),transparent_70%)]"
	>
	</div>

	<div
		class="relative mx-auto flex max-w-[1220px] flex-col items-center gap-9 md:grid md:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)] md:gap-[clamp(32px,4vw,64px)]"
	>
		<div class="order-1 animate-rise-in md:order-none">
			<div
				class="mb-[clamp(22px,3vw,32px)] inline-flex items-center gap-2.5 rounded-full border border-border bg-white px-3.5 py-1.5 text-[13px] font-semibold text-muted-600 shadow-[0_4px_14px_-8px_rgba(11,11,18,0.2)]"
			>
				<span class="h-1.5 w-1.5 rounded-full bg-success"></span>
				mgr rachunkowości · certyfikacja SKwP
			</div>

			<h1
				class="text-[clamp(40px,6.4vw,80px)] leading-[1.0] tracking-[-0.035em]"
				style="text-wrap: balance;"
			>
				Księgowość dla firm, która <span
					class="bg-linear-to-r from-accent to-accent-3 bg-clip-text text-transparent"
					>nie zostawia Cię z tym sama</span
				>
			</h1>

			<p class="mt-[clamp(18px,2.4vw,26px)] max-w-[52ch] text-[clamp(16px,1.35vw,19px)] leading-[1.6] text-muted-600">
				Prowadzę jednoosobowe działalności na zasadach ogólnych, podatku liniowym i ryczałcie —
				w pełni zdalnie, terminowo i z realnym kontaktem. Bez papierologii, kolejek i stresu.
			</p>

			<div class="mt-[clamp(26px,3vw,38px)] flex flex-col flex-wrap gap-3 sm:flex-row">
				<a
					href="#kontakt"
					class="inline-flex h-14 items-center justify-center gap-2.5 rounded-2xl bg-linear-to-br from-accent to-accent-2 px-7 text-base font-bold text-white shadow-[0_18px_34px_-14px_rgba(79,91,242,0.75)] transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_24px_44px_-14px_rgba(79,91,242,0.85)]"
				>
					Umów bezpłatną konsultację
				</a>
				<a
					href="#cennik"
					class="inline-flex h-14 items-center justify-center rounded-2xl border border-border-3 bg-white px-6.5 text-base font-bold text-ink transition-transform duration-200 hover:-translate-y-0.5"
				>
					Zobacz cennik
				</a>
			</div>

			<div class="mt-[clamp(24px,3vw,34px)] flex flex-wrap gap-2">
				{
					trustBadges.map((badge, i) => (
						<>
							{i > 0 && <span class="h-4 w-px self-center bg-border-5" />}
							<span class="inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-muted-600">
								<Icon name="check" size={16} strokeWidth={2.4} class="text-success" />
								{badge}
							</span>
						</>
					))
				}
			</div>
		</div>

		<div class="order-2 flex w-full animate-rise-in-delayed flex-col gap-3.5 md:order-none">
			<div
				class="relative h-[300px] overflow-hidden rounded-[22px] bg-linear-to-br from-[#EEF0FF] via-[#F5F6FB] to-[#E9EBFC] shadow-[0_30px_60px_-34px_rgba(11,11,18,0.4)] md:h-[260px]"
			>
				<div class="absolute inset-0 flex flex-col items-center justify-center gap-2 text-muted-200">
					<Icon name="users" size={40} strokeWidth={1.4} />
					<span class="text-[13px] font-semibold">Zdjęcie — Aleksandra Potocka</span>
				</div>
			</div>

			<div
				class="rounded-[20px] border border-border-2 bg-white p-[22px] shadow-[0_24px_48px_-30px_rgba(11,11,18,0.3)]"
			>
				<div class="flex items-center justify-between">
					<span class="text-[12.5px] font-bold uppercase tracking-[0.6px] text-muted-200">
						Podatek · marzec
					</span>
					<span class="rounded-full bg-success-soft px-2.5 py-1 text-[11.5px] font-bold text-success">
						policzone
					</span>
				</div>
				<div class="mt-2 font-display text-[38px] font-extrabold tracking-[-0.03em]">431 zł</div>
				<div class="mt-4 flex flex-col gap-2.5">
					<div class="flex justify-between text-[13.5px]">
						<span class="text-muted-400">PIT</span>
						<span class="font-bold">248 zł</span>
					</div>
					<div class="h-px bg-border-4"></div>
					<div class="flex justify-between text-[13.5px]">
						<span class="text-muted-400">VAT</span>
						<span class="font-bold">0 zł</span>
					</div>
					<div class="h-px bg-border-4"></div>
					<div class="flex justify-between text-[13.5px]">
						<span class="text-muted-400">ZUS</span>
						<span class="font-bold">183 zł</span>
					</div>
				</div>
			</div>

			<div
				class="rounded-[20px] bg-linear-to-br from-accent to-accent-2 px-[22px] py-5 text-white shadow-[0_24px_48px_-26px_rgba(79,91,242,0.7)]"
			>
				<div class="flex items-center gap-3">
					<span class="grid h-[42px] w-[42px] flex-shrink-0 place-items-center rounded-xl bg-white/18">
						<Icon name="calendar-check" size={20} strokeWidth={1.9} />
					</span>
					<div>
						<div class="text-[15.5px] font-bold">Terminy dopilnowane ✓</div>
						<div class="text-[13px] opacity-[0.82]">Nie musisz pamiętać o żadnej dacie.</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</header>
