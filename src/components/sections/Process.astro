---
import { fixOrphans } from "../../lib/typography";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

const steps = [
	{
		title: "Bezpłatna konsultacja",
		description: "Poznajemy Twoją działalność, jej skalę i formę opodatkowania, w jakiej już działasz lub planujesz działać.",
	},
	{
		title: "Umowa i pełnomocnictwo",
		description: "Podpisujemy umowę i pełnomocnictwa zdalnie, żebym mogła działać w Twoim imieniu.",
	},
	{
		title: "Przekazanie dokumentów",
		description: "Wysyłasz faktury zdjęciem lub mailem — kiedy Ci wygodnie.",
	},
	{
		title: "Spokój i terminy",
		description: "Rozliczam, pilnuję terminów i informuję o kwotach do zapłaty.",
	},
];
---

<Section
	padding="none"
	class="bg-surface-1 px-[clamp(18px,4vw,56px)] py-[clamp(60px,8vw,110px)]"
>
	<SectionHeading
		eyebrow="Jak zaczynamy"
		heading="Cztery kroki i masz księgowość z głowy"
		align="center"
		size="lg"
		headingWidth="md"
	/>
	<div data-reveal-group class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4 lg:gap-4.5">
		{
			steps.map((step, i) => (
				<div data-reveal class="rounded-[20px] border border-border-2 bg-white p-6.5">
					<div class="mb-4.5 grid h-11 w-11 place-items-center rounded-[13px] bg-linear-to-br from-accent to-accent-2 font-display font-extrabold text-white">
						{i + 1}
					</div>
					<h3 class="text-[19px] leading-[1.3] tracking-[-0.01em] text-balance">
						{fixOrphans(step.title)}
					</h3>
					<p class="mt-2.5 text-[14.5px] leading-[1.55] text-pretty text-muted-400">
						{fixOrphans(step.description)}
					</p>
				</div>
			))
		}
	</div>
</Section>
