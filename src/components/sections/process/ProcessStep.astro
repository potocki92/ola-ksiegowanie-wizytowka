---
import { fixOrphans } from "../../../lib/typography";

interface Props {
	/**
	 * Numer kroku liczony od zera. Trafia do CSS jako `--process-i` i steruje
	 * tam obiema kaskadami naraz: zakresami scrolla w wersji scroll-driven
	 * i `--reveal-delay` w wersji zapasowej.
	 */
	index: number;
	title: string;
	description: string;
	/** Ostatni krok nie ciągnie sznurka dalej — nie ma już do czego. */
	isLast: boolean;
}

const { index, title, description, isLast } = Astro.props;
---

<!-- Sznurek biegnie od środka TEGO numerka do środka numerka następnego kroku,
     więc jego długość to wysokość/szerokość kroku plus odstęp siatki
     (`--rope-gap`, ustawiany na liście razem z `gap`). Numerek stoi na
     sznurku (`relative`), więc zakrywa jego początek — bez zabaw z z-index.

     `<li>` nie animuje się sam: jest tylko hakiem dla obserwatora
     (`data-reveal`) i nośnikiem osi czasu widoku. Cały ruch robią dzieci,
     bo numerek jest węzłem sznurka i musi stać nieruchomo dokładnie na nim,
     podczas gdy kafelek pod nim podjeżdża. -->
<li
	data-reveal
	data-process-step
	style={`--process-i:${index}`}
	class="relative grid grid-cols-[44px_minmax(0,1fr)] items-start gap-x-4 lg:flex lg:flex-col lg:items-stretch"
>
	{
		/*
			Sznurek to rysowana ścieżka SVG, nie kreska odsłaniana maską —
			`stroke-dashoffset` prowadzi czubek WZDŁUŻ łuku, czego `clip-path`
			nie potrafi (ścinałby krzywą prostopadle).

			`pathLength="1"` normalizuje długość ścieżki do jedynki niezależnie
			od jej kształtu i rozmiaru, więc `stroke-dasharray: 1` +
			`dashoffset: 1 → 0` rysuje ją w całości na każdym ekranie — bez
			mierzenia `getTotalLength()` w JS. Ten sam chwyt co przy checkmarku
			sukcesu formularza (ContactSuccess.astro).

			Dwa osobne `<svg>`, bo `viewBox` i `d` nie są sterowalne z media
			query, a każdy układ potrzebuje własnej orientacji. Oś POPRZECZNA
			ma dokładnie 40 px i tyle samo jednostek viewBoxa, więc mapuje się
			1:1. To daje dwie rzeczy naraz: wybrzuszenie ma równe 10 px
			niezależnie od wysokości karty, a kreska ma równe 2 px, bo jej
			grubość mierzy się w poprzek linii — czyli właśnie w tej
			nieskalowanej osi. Oś wzdłużna rozciąga się dowolnie, bo tam
			ścieżka i tak biegnie od numerka do numerka.

			Dlatego NIE ma tu `vector-effect="non-scaling-stroke"`, choć przy
			`preserveAspectRatio="none"` byłby odruchem. Liczy on wzór
			kreskowania w przestrzeni ekranu, podczas gdy `pathLength` normalizuje
			go w przestrzeni użytkownika — te dwa mechanizmy się gryzą i odcinek
			rozpada się na kilka kawałków (sprawdzone). Nie jest potrzebny,
			bo oś poprzeczna i tak jest 1:1.

			Styczne na obu końcach są wzdłuż osi, więc sąsiednie odcinki
			schodzą się bez załamania.
		*/
		!isLast && (
			<Fragment>
				<svg
					data-rope
					data-rope-axis="y"
					aria-hidden="true"
					focusable="false"
					fill="none"
					viewBox="0 0 40 100"
					preserveAspectRatio="none"
					class="pointer-events-none absolute top-[22px] left-[2px] h-[calc(100%+var(--rope-gap))] w-10 lg:hidden"
				>
					<path
						pathLength="1"
						d="M20 0 C20 14 30 22 30 50 C30 78 20 86 20 100"
						stroke="url(#rope-gradient-y)"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
				<svg
					data-rope
					data-rope-axis="x"
					aria-hidden="true"
					focusable="false"
					fill="none"
					viewBox="0 0 100 40"
					preserveAspectRatio="none"
					class="pointer-events-none absolute top-[2px] left-[22px] hidden h-10 w-[calc(100%+var(--rope-gap))] lg:block"
				>
					<path
						pathLength="1"
						d="M0 20 C14 20 22 10 50 10 C78 10 86 20 100 20"
						stroke="url(#rope-gradient-x)"
						stroke-width="2"
						stroke-linecap="round"
					/>
				</svg>
			</Fragment>
		)
	}
	<div
		data-process-badge
		class="relative grid h-11 w-11 place-items-center rounded-[13px] bg-linear-to-br from-accent to-accent-2 font-display font-extrabold text-white"
	>
		{index + 1}
	</div>
	<!-- Hover zostaje na samym cieniu, bez `hover:-translate-y-1` obecnego na
	     pozostałych kartach strony: numerek stoi na sznurku tuż nad kafelkiem
	     i podniesienie kafelka rozjeżdżałoby ten styk. -->
	<div
		data-process-card
		data-glow
		class="rounded-[20px] border border-border-2 bg-white p-5 transition-shadow duration-250 hover:shadow-[0_22px_40px_-28px_rgba(11,11,18,0.3)] sm:p-6.5 lg:mt-5 lg:grow"
	>
		<h3 class="text-[19px] leading-[1.3] tracking-[-0.01em] text-balance">
			{fixOrphans(title)}
		</h3>
		<p class="mt-2.5 text-[14.5px] leading-[1.55] text-pretty text-muted-400">
			{fixOrphans(description)}
		</p>
	</div>
</li>
