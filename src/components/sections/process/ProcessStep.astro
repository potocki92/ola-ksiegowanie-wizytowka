---
import { fixOrphans } from "../../../lib/typography";

interface Props {
	/** Numer kroku liczony od zera — daje etykietę i opóźnienie kaskady. */
	index: number;
	title: string;
	description: string;
	/** Ostatni krok nie ciągnie sznurka dalej — nie ma już do czego. */
	isLast: boolean;
}

const { index, title, description, isLast } = Astro.props;

// Odstęp między wejściem kolejnych kroków. Działa tylko w układzie poziomym
// (lg), gdzie wszystkie cztery wjeżdżają w viewport naraz — patrz global.css.
const CASCADE_STEP_MS = 130;
---

<!-- Sznurek biegnie od środka TEGO numerka do środka numerka następnego kroku,
     więc jego długość to wysokość/szerokość kroku plus odstęp siatki
     (`--rope-gap`, ustawiany na liście razem z `gap`). Numerek stoi na
     sznurku (`relative`), więc zakrywa jego początek — bez zabaw z z-index. -->
<li
	data-reveal
	data-process-step
	style={`--process-delay:${index * CASCADE_STEP_MS}ms`}
	class="relative grid grid-cols-[44px_minmax(0,1fr)] items-start gap-x-4 lg:flex lg:flex-col lg:items-stretch"
>
	{
		!isLast && (
			<span
				data-rope
				aria-hidden="true"
				class="pointer-events-none absolute top-[22px] left-[21px] h-[calc(100%+var(--rope-gap))] w-0.5 rounded-full bg-linear-to-b from-accent to-accent-2 lg:top-[21px] lg:left-[22px] lg:h-0.5 lg:w-[calc(100%+var(--rope-gap))] lg:bg-linear-to-r"
			/>
		)
	}
	<div
		class="relative grid h-11 w-11 place-items-center rounded-[13px] bg-linear-to-br from-accent to-accent-2 font-display font-extrabold text-white"
	>
		{index + 1}
	</div>
	<!-- Hover zostaje na samym cieniu, bez `hover:-translate-y-1` obecnego na
	     pozostałych kartach strony: numerek stoi na sznurku tuż nad kafelkiem
	     i podniesienie kafelka rozjeżdżałoby ten styk. -->
	<div
		data-process-card
		data-glow
		class="rounded-[20px] border border-border-2 bg-white p-5 transition-shadow duration-250 hover:shadow-[0_22px_40px_-28px_rgba(11,11,18,0.3)] sm:p-6.5 lg:mt-5 lg:grow"
	>
		<h3 class="text-[19px] leading-[1.3] tracking-[-0.01em] text-balance">
			{fixOrphans(title)}
		</h3>
		<p class="mt-2.5 text-[14.5px] leading-[1.55] text-pretty text-muted-400">
			{fixOrphans(description)}
		</p>
	</div>
</li>
