---
import { fixOrphans } from "../../lib/typography";
import { type IconName } from "../ui/Icon.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import IconTile from "../ui/IconTile.astro";

interface ValueCard {
	icon: IconName;
	title: string;
	description: string;
}

const cards: ValueCard[] = [
	{
		icon: "chat",
		title: "Stały kontakt",
		description:
			"Odpowiadam na wiadomości i telefony. Masz jedną osobę od początku do końca — wiesz, z kim rozmawiasz.",
	},
	{
		icon: "check-circle",
		title: "Indywidualne podejście",
		description:
			"Każdą sytuację analizuję indywidualnie. Przedstawiam dostępne formy opodatkowania, wyjaśniam różnice i dbam o prawidłowe rozliczenia.",
	},
	{
		icon: "cloud",
		title: "Księgowość online",
		description: "Dokumenty przesyłasz zdjęciem lub mailem, kiedy Ci wygodnie. Działam zdalnie — bez dojazdów.",
	},
];
---

<Section
	padding="none"
	class="overflow-hidden bg-ink px-[clamp(18px,4vw,56px)] py-[clamp(60px,8vw,120px)] text-white"
	glow="bg-[radial-gradient(50%_50%_at_85%_0%,rgba(123,108,246,0.22),transparent_70%)]"
>
	<SectionHeading
		eyebrow="Jak pracuję"
		heading="Nie jesteś numerem w kolejce dużego biura"
		tone="dark"
		size="lg"
		headingWidth="md"
	/>
	<div data-reveal-group class="grid gap-3.5 md:grid-cols-3 md:gap-5">
		{
			cards.map((card) => (
				<div data-reveal class="rounded-[22px] border border-white/9 bg-white/4.5 p-[clamp(24px,2.4vw,34px)] transition-all duration-250 hover:-translate-y-1 hover:bg-white/7">
					<IconTile
						icon={card.icon}
						size="md"
						tone="soft-tint"
						iconSize={24}
						iconStrokeWidth={1.8}
						class="mb-5"
					/>
					<h3 class="text-[19px] leading-[1.3] tracking-[-0.01em] text-balance">
						{fixOrphans(card.title)}
					</h3>
					<p class="mt-3 text-[15px] leading-[1.6] text-pretty text-white/68">
						{fixOrphans(card.description)}
					</p>
				</div>
			))
		}
	</div>
</Section>
