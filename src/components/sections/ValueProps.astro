---
import Icon, { type IconName } from "../ui/Icon.astro";

interface ValueCard {
	icon: IconName;
	title: string;
	description: string;
}

const cards: ValueCard[] = [
	{
		icon: "chat",
		title: "Stały kontakt",
		description:
			"Odpowiadam na wiadomości i telefony. Masz jedną osobę od początku do końca — wiesz, z kim rozmawiasz.",
	},
	{
		icon: "check-circle",
		title: "Indywidualne podejście",
		description:
			"Analizuję Twoją sytuację, a nie szablon. Doradzam formę opodatkowania i podpowiadam, na czym oszczędzasz.",
	},
	{
		icon: "cloud",
		title: "Księgowość online",
		description: "Dokumenty przesyłasz zdjęciem lub mailem, kiedy Ci wygodnie. Działam zdalnie — bez dojazdów.",
	},
];
---

<section class="relative overflow-hidden bg-ink px-[clamp(18px,4vw,56px)] py-[clamp(60px,8vw,120px)] text-white">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(50%_50%_at_85%_0%,rgba(123,108,246,0.22),transparent_70%)]"
	>
	</div>
	<div class="relative mx-auto max-w-[1220px]">
		<div class="mb-[clamp(36px,4vw,56px)] max-w-[34ch]">
			<div class="mb-3.5 text-[13px] font-bold tracking-[1px] text-accent-soft uppercase">Jak pracuję</div>
			<h2 class="text-[clamp(30px,4.6vw,56px)] leading-[1.02] tracking-[-0.03em]">
				Nie jesteś numerem w kolejce dużego biura
			</h2>
		</div>
		<div class="grid gap-3.5 md:grid-cols-3 md:gap-5">
			{
				cards.map((card) => (
					<div class="rounded-[22px] border border-white/9 bg-white/[0.045] p-[clamp(24px,2.4vw,34px)] transition-all duration-[250ms] hover:-translate-y-1 hover:bg-white/7">
						<div class="mb-5 inline-grid h-[50px] w-[50px] place-items-center rounded-2xl bg-accent-soft/14">
							<Icon name={card.icon} size={24} strokeWidth={1.8} class="text-accent-soft" />
						</div>
						<h3 class="text-xl">{card.title}</h3>
						<p class="mt-3 text-[15px] leading-[1.6] text-white/68">{card.description}</p>
					</div>
				))
			}
		</div>
	</div>
</section>
