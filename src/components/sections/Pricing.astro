---
import CheckItem from "../ui/CheckItem.astro";
import Icon from "../ui/Icon.astro";
import IconTile from "../ui/IconTile.astro";
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";

const plans = [
	{ label: "Bez VAT", promo: "250 zł", regular: "350 zł" },
	{ label: "Z VAT", promo: "350 zł", regular: "450 zł" },
];

const includedItems = [
	"Prowadzenie KPiR / ryczałtu",
	"Rozliczenia VAT i JPK",
	"Deklaracje i rozliczenia ZUS",
	"Pomoc w wyborze formy",
	"Przypomnienia o terminach",
	"Stały kontakt z księgową",
];

const reassurances = ["Bez umowy na czas określony", "Wycena w 24 h", "Bez ukrytych opłat"];
---

<Section id="cennik" maxWidth="max-w-250">
	<SectionHeading
		eyebrow="Cennik"
		heading="Jasna cena. Bez ukrytych dopłat."
		lead="Ostateczną stawkę ustalam po bezpłatnej konsultacji — zależy od formy opodatkowania, VAT-u i liczby dokumentów w miesiącu."
		align="center"
		size="lg"
	/>

	<div data-reveal-group class="grid gap-3.5 md:grid-cols-[minmax(0,1.25fr)_minmax(0,0.75fr)] md:gap-5">
		<div
			data-reveal
			class="relative overflow-hidden rounded-[26px] bg-linear-to-br from-muted-900 to-muted-800 p-[clamp(28px,3.2vw,44px)] text-white shadow-[0_30px_60px_-34px_rgba(11,11,18,0.5)]"
		>
			<div
				class="pointer-events-none absolute -top-12.5 -right-12.5 h-55 w-55 rounded-full bg-[radial-gradient(circle,rgba(123,108,246,0.4),transparent_70%)]"
			>
			</div>
			<div class="relative">
				<div class="flex items-center justify-between gap-3">
					<div class="text-[13px] font-bold tracking-[0.5px] text-white/60 uppercase">
						Prowadzenie JDG
					</div>
					<span
						class="inline-flex items-center gap-1.5 rounded-full bg-success-mint/12 px-3 py-1 text-[11.5px] font-bold tracking-[0.4px] text-success-mint uppercase"
					>
						<span class="h-1.5 w-1.5 rounded-full bg-success-mint"></span>
						Promocja
					</span>
				</div>
				<div class="mt-4 grid gap-4 sm:grid-cols-2 sm:gap-5">
					{
						plans.map((plan) => (
							<div>
								<div class="text-[12px] font-bold tracking-[0.5px] text-white/50 uppercase">
									{plan.label}
								</div>
								<div class="mt-1 flex flex-wrap items-baseline gap-x-2 gap-y-0.5">
									<span class="text-sm opacity-70">od</span>
									<span class="font-display text-[clamp(32px,4.6vw,48px)] leading-none font-extrabold tracking-[-0.03em]">
										{plan.promo}
									</span>
									<span class="text-sm opacity-70">/ mies.</span>
									<span class="ml-1 font-display text-[17px] font-bold text-white/40 line-through decoration-white/35 decoration-2">
										{plan.regular}
									</span>
								</div>
							</div>
						))
					}
				</div>
				<div class="mt-3 text-[13px] text-white/55">
					Ceny do 20 dokumentów miesięcznie
				</div>
				<CheckItem
					as="div"
					size={15}
					strokeWidth={2.6}
					class="mt-3 inline-flex items-center gap-2 rounded-full bg-success-mint/12 px-3.5 py-1.5 text-[13px] font-bold text-success-mint"
				>
					100 zł taniej dla nowych klientów
				</CheckItem>
				<div class="my-6 h-px bg-white/16"></div>
				<ul class="grid gap-3 sm:grid-cols-2 sm:gap-x-6 sm:gap-y-3.5">
					{
						includedItems.map((item) => (
							<CheckItem
								as="li"
								tone="success-mint"
								size={18}
								iconClass="mt-px"
								class="flex items-start gap-2.5 text-[14.5px] font-medium"
							>
								{item}
							</CheckItem>
						))
					}
				</ul>
				<Button href="#kontakt" variant="inverse" class="mt-7.5 text-muted-900">
					Wyceń moją firmę →
				</Button>
				<div class="mt-4 flex flex-wrap gap-x-4 gap-y-1.5">
					{
						reassurances.map((item) => (
							<CheckItem
								tone="success-mint"
								class="inline-flex items-center gap-1.5 text-[13px] text-white/55"
							>
								{item}
							</CheckItem>
						))
					}
				</div>
			</div>
			
		</div>
		<div
			data-reveal
			class="flex flex-col rounded-[26px] border border-border-2 bg-white p-[clamp(26px,3vw,40px)] shadow-[0_16px_40px_-30px_rgba(11,11,18,0.25)]"
		>
			<div class="text-[13px] font-bold tracking-[0.5px] text-muted-100 uppercase">
				Założenie JDG
			</div>
			<div class="mt-3 font-display text-[clamp(28px,3.6vw,40px)] leading-[1.05] font-extrabold tracking-[-0.02em]">
				W cenie<br />prowadzenia
			</div>
			<p class="mt-3.5 text-[14.5px] leading-[1.6] text-muted-600">
				Rejestracja firmy jest bezpłatna, gdy zostajemy na dłużej. Sama rejestracja bez dalszej
				współpracy — <strong class="font-extrabold text-ink">50 zł jednorazowo</strong>.
			</p>
			<div class="mt-5 rounded-2xl bg-surface-tint p-4">
				<div class="flex items-center gap-2.5 text-[13.5px] font-bold text-link">
					<Icon name="calendar-check" size={18} strokeWidth={2} class="shrink-0" />
					Przejście z innego biura — bezpłatnie
				</div>
				<p class="mt-1.5 text-[13px] leading-[1.55] text-muted-400">
					Przejmuję dokumentację i formalności za Ciebie. Zmienić biuro możesz w trakcie roku.
				</p>
			</div>
			<div class="mt-auto border-border-4 pt-5 text-[13px] text-muted-300">
				Umowę i pełnomocnictwo (UPL-1 i PEL) załatwiamy zdalnie.
			</div>
		</div>
	</div>

	<div data-reveal class="mt-3.5 md:mt-5">
		<div class="mb-3.5 flex items-center gap-2.5 md:mb-4">
			<span class="text-[13px] font-bold tracking-[0.5px] text-muted-100 uppercase">
				Usługi dodatkowe
			</span>
			<span class="h-px flex-1 bg-border-2"></span>
		</div>
		<div class="grid gap-3.5 sm:grid-cols-2 md:gap-5">
			<!-- Kadry i płace -->
			<div
				class="flex flex-col rounded-[26px] border border-border-2 bg-white p-[clamp(24px,2.6vw,32px)] shadow-[0_16px_40px_-30px_rgba(11,11,18,0.25)]"
			>
				<div class="flex items-center gap-3">
					<IconTile icon="users" size="sm" iconSize={20} />
					<div class="text-[13px] font-bold tracking-[0.5px] text-muted-100 uppercase">
						Kadry i płace
					</div>
				</div>
				<div class="mt-4 flex items-baseline gap-2">
					<span class="font-display text-[clamp(26px,3vw,34px)] font-extrabold tracking-[-0.02em]">
						od 30 zł
					</span>
					<span class="text-[14px] text-muted-400">/ os. / mies.</span>
				</div>
				<p class="mt-3 text-[14px] leading-[1.55] text-muted-600">
					Listy płac, ZUS, PPK i akta osobowe — za każdego pracownika i zleceniobiorcę.
				</p>
				<div class="mt-auto flex gap-2.5 pt-5">
					<div class="flex-1 rounded-xl bg-surface-tint p-3">
						<div class="text-[12px] font-semibold text-muted-400">Umowa zlecenie</div>
						<div class="mt-0.5 font-display text-lg font-extrabold">30 zł</div>
					</div>
					<div class="flex-1 rounded-xl bg-surface-tint p-3">
						<div class="text-[12px] font-semibold text-muted-400">Umowa o pracę</div>
						<div class="mt-0.5 font-display text-lg font-extrabold">50 zł</div>
					</div>
				</div>
			</div>
			<!-- Rozliczenie roczne PIT -->
			<div
				class="flex flex-col rounded-[26px] border border-border-2 bg-white p-[clamp(24px,2.6vw,32px)] shadow-[0_16px_40px_-30px_rgba(11,11,18,0.25)]"
			>
				<div class="flex items-center gap-3">
					<IconTile icon="file-text" size="sm" iconSize={20} />
					<div class="text-[13px] font-bold tracking-[0.5px] text-muted-100 uppercase">
						Rozliczenie roczne PIT
					</div>
				</div>
				<div class="mt-4 flex items-baseline gap-2">
					<span class="font-display text-[clamp(26px,3vw,34px)] font-extrabold tracking-[-0.02em]">
						od 100 zł
					</span>
					<span class="text-[14px] text-muted-400">jednorazowo</span>
				</div>
				<p class="mt-3 text-[14px] leading-[1.55] text-muted-600">
					Roczne zeznanie (PIT-37, PIT-36, PIT-28) dla osób bez stałej obsługi. Sprawdzę ulgi
					i odliczenia, których nie chcesz przegapić.
				</p>
				<div class="mt-auto flex flex-wrap gap-x-4 gap-y-1.5 pt-5">
					<CheckItem tone="success" class="inline-flex items-center gap-1.5 text-[13px] text-muted-400">
						Wszystkie źródła dochodu
					</CheckItem>
					<CheckItem tone="success" class="inline-flex items-center gap-1.5 text-[13px] text-muted-400">
						Ulgi i odliczenia
					</CheckItem>
				</div>
			</div>
		</div>
	</div>
</Section>
