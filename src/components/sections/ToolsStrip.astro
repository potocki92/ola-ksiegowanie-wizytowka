---
const tools = ["Comarch Optima", "Symfonia", "Płatnik", "Subiekt GT", "Rachmistrz GT"];
---

<section class="border-y border-border-2 px-[clamp(18px,4vw,56px)] py-[clamp(28px,3vw,40px)]">
	<div class="mx-auto max-w-[1220px]">
		<div class="mb-[18px] text-center text-[12.5px] font-bold tracking-[1px] text-muted-100 uppercase">
			Pracuję w programach, które znasz z rynku
		</div>
		<div class="flex flex-wrap items-center justify-center gap-[clamp(18px,3vw,48px)]">
			{
				tools.map((tool) => (
					<span class="font-display text-[clamp(16px,1.7vw,22px)] font-bold text-muted-500">
						{tool}
					</span>
				))
			}
		</div>
	</div>
</section>
