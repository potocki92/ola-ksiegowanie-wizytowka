---
import Icon, { type IconName } from "../../ui/Icon.astro";

interface Props {
	icon: IconName;
	label: string;
	value: string;
	href?: string;
	breakValue?: boolean;
}

const {
	icon,
	label,
	value,
	href,
	breakValue = false,
} = Astro.props;

const Tag = href ? "a" : "div";

// `<wbr>` łamie tylko po "@" (granica lokalna-część/domena), zamiast
// pozwalać `break-all` ciąć w dowolnym miejscu w środku wyrazu.
const [localPart, domainPart] = breakValue ? value.split("@") : [];
---

<Tag href={href} class="flex items-center gap-3.5 text-white">
	<span
		class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full border border-white/13 bg-white/5"
	>
		<Icon name={icon} size={20} strokeWidth={1.8} class="text-accent-soft" />
	</span>

	<span class="min-w-0">
		<span class="block text-xs tracking-[0.5px] text-white/55 uppercase">
			{label}
		</span>

		<span
			class:list={[
				"font-display text-[19px] font-bold",
				breakValue && "break-words",
			]}
		>
			{breakValue && domainPart !== undefined ? (
				<>{localPart}@<wbr />{domainPart}</>
			) : (
				value
			)}
		</span>
	</span>
</Tag>
