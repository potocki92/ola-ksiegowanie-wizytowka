---
import Icon, { type IconName } from "../../ui/Icon.astro";

interface Props {
	icon: IconName;
	label: string;
	value: string;
	href?: string;
	breakValue?: boolean;
}

const {
	icon,
	label,
	value,
	href,
	breakValue = false,
} = Astro.props;

const Tag = href ? "a" : "div";
---

<Tag href={href} class="flex items-center gap-3.5 text-white">
	<Icon
		name={icon}
		size={22}
		strokeWidth={1.8}
		class="shrink-0 text-accent-soft"
	/>

	<span class="min-w-0">
		<span class="block text-xs tracking-[0.5px] text-white/55 uppercase">
			{label}
		</span>

		<span
			class:list={[
				"font-display text-[19px] font-bold",
				breakValue && "break-all",
			]}
		>
			{value}
		</span>
	</span>
</Tag>
