---
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
import ContactDetails from "./ContactDetails.astro";
import ContactForm from "./ContactForm.astro";
---

<Section
	id="kontakt"
	padding="none"
	class="px-[clamp(18px,4vw,56px)] py-[clamp(40px,6vw,96px)]"
>
	<div
		class="relative overflow-hidden rounded-[clamp(24px,3vw,36px)] bg-linear-to-br from-muted-900 to-ink p-[clamp(28px,4vw,72px)] text-white"
	>
		<div
			class="pointer-events-none absolute -top-16 -right-16 h-70 w-70 rounded-full bg-[radial-gradient(circle,rgba(123,108,246,0.35),transparent_70%)] blur-2xl md:h-90 md:w-90"
		></div>

		<div
			class="relative grid gap-8 md:grid-cols-2 md:gap-[clamp(40px,5vw,72px)]"
		>
			<div data-reveal="left">
				<SectionHeading
					eyebrow="Kontakt"
					heading="Zacznijmy od bezpłatnej rozmowy"
					tone="dark"
					variant="inline"
					size="md"
					headingWidth="none"
					leadWidth="max-w-[40ch]"
					leadClass="text-[16.5px]"
					lead="Opowiedz mi w kilku zdaniach o swojej działalności. Odezwę się z konkretną wyceną i informacją o możliwym zakresie współpracy."
				/>

				<ContactDetails />
			</div>

			<ContactForm />
		</div>
	</div>
</Section>