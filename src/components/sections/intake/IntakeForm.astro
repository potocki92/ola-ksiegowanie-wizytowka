---
/**
 * Ankieta w całości: składa sekcje pytań, pola techniczne i kartę sukcesu.
 *
 * Dodając pytanie, wystarczy zajrzeć w dwa–trzy miejsca:
 * `sections/*.astro` (pole), `features/intake/intake.schema.ts` (walidacja)
 * i — dla selecta — `features/intake/intake.options.ts` (opcje). Prezentacja
 * w mailach bierze się z `features/intake/intake.summary.ts`.
 */
import Button from "../../ui/Button.astro";
import Form from "../../ui/form/Form.astro";
import SpamProtectionFields from "../../ui/form/SpamProtectionFields.astro";
import { company } from "../../../data/company";
import IntakeSuccess from "./IntakeSuccess.astro";
import IntakeAccountingSection from "./sections/IntakeAccountingSection.astro";
import IntakeBusinessSection from "./sections/IntakeBusinessSection.astro";
import IntakeContactSection from "./sections/IntakeContactSection.astro";
import IntakeNotesSection from "./sections/IntakeNotesSection.astro";
import IntakeSituationSection from "./sections/IntakeSituationSection.astro";

// Numer i adres pochodzą z jednego źródła (`data/company.ts`), a skrypt
// modułowy nie widzi frontmatteru — treść błędu jedzie do niego atrybutem.
const fallbackError = `Nie udało się wysłać ankiety. Zadzwoń: ${company.contact.phone.display} lub napisz na ${company.contact.email}`;
---

<div data-intake-block data-fallback-error={fallbackError}>
	<Form data-form action="/api/intake" method="POST" gap="md">
		<IntakeContactSection />
		<IntakeBusinessSection />
		<IntakeAccountingSection />
		<IntakeSituationSection />
		<IntakeNotesSection />

		<SpamProtectionFields idPrefix="intake" />

		<Button
			data-form-submit
			type="submit"
			variant="primary"
			class="mt-1 h-13.5 cursor-pointer font-[inherit] disabled:pointer-events-none disabled:opacity-60"
		>
			Wyślij ankietę
		</Button>

		{/*
			Komunikat błędu jest osobnym regionem `role="alert"` — bez utility
			wyświetlania, inaczej `[hidden]` z preflightu Tailwinda przegrywa.
		*/}
		<p
			data-form-error
			role="alert"
			hidden
			class="rounded-xl border border-[rgba(255,107,107,0.32)] bg-[rgba(255,107,107,0.12)] px-4 py-3 text-center text-[13.5px] leading-relaxed text-[#ffc2c2]"
		>
		</p>

		<p class="text-center text-xs leading-relaxed text-white/50">
			Dane z ankiety wykorzystamy wyłącznie po to, żeby przygotować się do
			rozmowy z Tobą. Szczegóły w <a
				href="/polityka-prywatnosci"
				class="text-white/70 underline underline-offset-2 hover:text-white"
				>Polityce prywatności</a
			>.
		</p>

		<noscript>
			<p class="text-center text-[13px] leading-relaxed text-white/60">
				Wysyłka formularza wymaga włączonego JavaScriptu. Napisz na <a
					href={`mailto:${company.contact.email}`}
					class="text-accent-soft underline">{company.contact.email}</a
				> lub zadzwoń: <a
					href={`tel:${company.contact.phone.href}`}
					class="text-accent-soft underline">{company.contact.phone.display}</a
				>.
			</p>
		</noscript>
	</Form>

	<IntakeSuccess />
</div>

<script>
	import { initIntakeConditionalFields } from "./intake-conditional-fields";
	import { initFormSubmission } from "../../../lib/forms/form-submission";

	const BLOCK = "[data-intake-block]";

	document.querySelectorAll<HTMLElement>(BLOCK).forEach(initIntakeConditionalFields);

	initFormSubmission({
		block: BLOCK,
		fallbackError:
			document.querySelector<HTMLElement>(BLOCK)?.dataset.fallbackError ??
			"Nie udało się wysłać ankiety. Spróbuj ponownie za chwilę.",
		onSuccess: (data, success) => {
			// Powiadomienie do właścicielki poszło (inaczej API zwróciłoby błąd),
			// ale kopia dla klienta bywa niedostarczona — komunikat musi mówić
			// prawdę, żeby nikt nie wypełniał ankiety drugi raz.
			const variant = data.clientCopySent === false ? "failed" : "sent";
			const paragraph = success.querySelector<HTMLElement>(
				`[data-copy-${variant}]`,
			);

			if (paragraph) {
				paragraph.hidden = false;
			}
		},
	});
</script>
