---
import Button from "../../ui/Button.astro";
import Form from "../../ui/form/Form.astro";
import TextField from "../../ui/form/TextField.astro";
import TextAreaField from "../../ui/form/TextAreaField.astro";
import SelectField from "../../ui/form/SelectField.astro";
import {
	businessStatusOptions,
	currentAccountingOptions,
	employmentOptions,
	legalFormOptions,
	preferredContactOptions,
	taxFormOptions,
	vatStatusOptions,
} from "../../../features/intake/intake.options";
import IntakeSuccess from "./IntakeSuccess.astro";

const sectionHeadingClass =
	"mt-2 border-t border-white/10 pt-6 text-[13px] font-bold tracking-[0.06em] text-white/55 uppercase first:mt-0 first:border-t-0 first:pt-0";
---

<div data-intake-block>
	<Form data-intake-form action="/api/intake" method="POST" gap="md">
		<h2 class={sectionHeadingClass}>Dane kontaktowe</h2>

		<TextField
			label="Imię i nazwisko"
			name="name"
			type="text"
			icon="user"
			required
			autocomplete="name"
			placeholder="Jan Kowalski"
		/>

		<TextField
			label="E-mail"
			name="email"
			type="email"
			icon="mail"
			required
			autocomplete="email"
			placeholder="jan@firma.pl"
		/>

		<TextField
			label="Telefon"
			name="phone"
			type="tel"
			icon="phone"
			autocomplete="tel"
			placeholder="533 032 455"
		/>

		<h2 class={sectionHeadingClass}>O firmie</h2>

		<TextAreaField
			label="Czym zajmuje się / będzie zajmować się Twoja firma?"
			name="businessDescription"
			icon="briefcase"
			rows={3}
			required
			placeholder="Np. projektowanie stron internetowych dla małych firm…"
		/>

		<SelectField label="Status działalności" name="businessStatus" icon="check-circle" required>
			<option value="" selected disabled>Wybierz…</option>
			{businessStatusOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<TextField
			label="Planowana / faktyczna data rozpoczęcia działalności"
			name="plannedStartDate"
			type="text"
			icon="calendar-check"
			placeholder="Np. wrzesień 2026"
		/>

		<SelectField label="Forma prawna" name="legalForm" icon="file-text" required>
			<option value="" selected disabled>Wybierz…</option>
			{legalFormOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<h2 class={sectionHeadingClass}>Rozliczenia</h2>

		<SelectField label="Forma opodatkowania" name="taxForm" icon="file-text" required>
			<option value="" selected disabled>Wybierz…</option>
			{taxFormOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<SelectField label="Status VAT" name="vatStatus" icon="file-text" required>
			<option value="" selected disabled>Wybierz…</option>
			{vatStatusOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<SelectField label="Czy planujesz zatrudniać pracowników lub zleceniobiorców?" name="employment" icon="users" required>
			<option value="" selected disabled>Wybierz…</option>
			{employmentOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<TextField
			label="Przybliżona liczba osób (jeśli dotyczy)"
			name="employeeCount"
			type="text"
			icon="users"
			placeholder="Np. 2"
		/>

		<TextField
			label="Szacowana liczba dokumentów miesięcznie lub przychód (opcjonalnie)"
			name="estimatedScale"
			type="text"
			icon="file-text"
			placeholder="Pomaga w wycenie — możesz zostawić puste"
		/>

		<h2 class={sectionHeadingClass}>Obecna sytuacja i uwagi</h2>

		<SelectField label="Czy masz już biuro rachunkowe / księgową?" name="currentAccounting" icon="check-circle" required>
			<option value="" selected disabled>Wybierz…</option>
			{currentAccountingOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<SelectField label="Preferowany sposób kontaktu" name="preferredContact" icon="phone" required>
			<option value="" selected disabled>Wybierz…</option>
			{preferredContactOptions.map((option) => <option value={option.value}>{option.label}</option>)}
		</SelectField>

		<TextAreaField
			label="Dodatkowe uwagi lub pytania"
			name="notes"
			icon="chat"
			rows={3}
			placeholder="Wszystko, co pomoże mi lepiej przygotować się do rozmowy…"
		/>

		{/*
			Pułapka na boty. Człowiek tego pola nie zobaczy i nie dojdzie do niego
			tabulatorem, więc każda wartość oznacza automat. Celowo `absolute`
			poza ekranem, a nie `display:none` — część botów pomija pola ukryte
			w oczywisty sposób.
		*/}
		<div
			aria-hidden="true"
			class="pointer-events-none absolute left-[9999px] h-0 w-0 overflow-hidden"
		>
			<label for="intake-company">Nazwa firmy</label>
			<input
				id="intake-company"
				name="company"
				type="text"
				tabindex="-1"
				autocomplete="off"
			/>
		</div>

		{/* Czas wypełniania — uzupełniany skryptem przy wysyłce. */}
		<input data-elapsed type="hidden" name="elapsed" value="" />

		{/* Etykieta osobnym elementem — skrypt podmienia sam tekst, żeby nie
		    skasować spinnera. Szczegóły w lib/formFlow.ts. */}
		<Button
			data-submit
			type="submit"
			variant="primary"
			class="mt-1 h-13.5 cursor-pointer font-[inherit] disabled:pointer-events-none disabled:opacity-60"
		>
			<span data-spinner aria-hidden="true"></span>
			<span data-submit-label>Wyślij ankietę</span>
		</Button>

		<p
			data-form-error
			role="alert"
			hidden
			class="rounded-xl border border-[rgba(255,107,107,0.32)] bg-[rgba(255,107,107,0.12)] px-4 py-3 text-center text-[13.5px] leading-relaxed text-[#ffc2c2]"
		>
		</p>

		<p class="text-center text-xs leading-relaxed text-white/50">
			Dane z ankiety wykorzystamy wyłącznie po to, żeby przygotować się do
			rozmowy z Tobą. Szczegóły w <a
				href="/polityka-prywatnosci"
				class="text-white/70 underline underline-offset-2 hover:text-white"
				>Polityce prywatności</a
			>.
		</p>

		<noscript>
			<p class="text-center text-[13px] leading-relaxed text-white/60">
				Wysyłka formularza wymaga włączonego JavaScriptu. Napisz na <a
					href="mailto:kontakt@potockaksiegowosc.pl"
					class="text-accent-soft underline">kontakt@potockaksiegowosc.pl</a
				> lub zadzwoń: <a href="tel:+48533032455" class="text-accent-soft underline"
					>533 032 455</a
				>.
			</p>
		</noscript>
	</Form>

	<IntakeSuccess />
</div>

<script>
	import { initFormFlow } from "../../../lib/formFlow";

	initFormFlow({
		block: "[data-intake-block]",
		form: "[data-intake-form]",
		success: "[data-intake-success]",
		fallbackError:
			"Nie udało się wysłać ankiety. Zadzwoń: 533 032 455 lub napisz na kontakt@potockaksiegowosc.pl",
		loadingLabel: "Wysyłam…",
	});
</script>
