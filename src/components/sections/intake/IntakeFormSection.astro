---
/**
 * Wizualna i semantyczna grupa pól ankiety. Sam nagłówek plus odstęp —
 * treść pytań mieszka w komponentach `sections/`.
 */
interface Props {
	title: string;
	/** Krótkie wyjaśnienie, po co pytamy o tę grupę danych. */
	description?: string;
}

const { title, description } = Astro.props;
const headingId = `intake-${title.toLowerCase().replace(/[^a-ząćęłńóśźż]+/g, "-")}`;
---

<section
	aria-labelledby={headingId}
	class="flex flex-col gap-5 border-t border-white/10 pt-7 first:border-t-0 first:pt-0"
>
	<div class="flex flex-col gap-1">
		<h2
			id={headingId}
			class="text-[13px] font-bold tracking-[0.06em] text-white/55 uppercase"
		>
			{title}
		</h2>

		{
			description && (
				<p class="text-[13px] leading-relaxed text-white/45">{description}</p>
			)
		}
	</div>

	<slot />
</section>
