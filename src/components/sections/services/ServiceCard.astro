---
import type { IconName } from "../../ui/Icon.astro";
import IconTile from "../../ui/IconTile.astro";

interface Props {
	icon: IconName;
	heading: string;
	description: string;
}

const { icon, heading, description } = Astro.props;
---

<div
	data-reveal
	class="col-span-2 flex flex-col gap-5 rounded-3xl border border-border-2 bg-white p-[clamp(24px,2.4vw,34px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.22)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.26)]"
>
	<div class="min-w-0 flex-1">
		<div class="mb-4 flex items-center gap-3 max-[360px]:flex-col max-[360px]:items-start max-[360px]:gap-2">
			<IconTile
				icon={icon}
				size="md"
				iconSize={22}
				iconStrokeWidth={1.9}
			/>
			<h3 class="text-[clamp(21px,2.2vw,26px)] tracking-[-0.02em]">{heading}</h3>
		</div>
		<p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted-400">
			{description}
		</p>
	</div>
	<slot />
</div>
