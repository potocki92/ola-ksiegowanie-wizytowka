---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<div class="flex items-center gap-2.5">
	<span class="grid h-5.5 w-5.5 place-items-center rounded-full bg-success text-[12px] font-extrabold text-white">
		✓
	</span>
	<span class="text-[13px] font-semibold">{label}</span>
</div>
