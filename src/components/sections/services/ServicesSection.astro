---
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
import ServiceFeatureCard from "./ServiceFeatureCard.astro";
import ServiceCard from "./ServiceCard.astro";
import ServiceChecklistItem from "./ServiceChecklistItem.astro";
import ServiceCta from "./ServiceCta.astro";
import { pricing } from "../../../data/pricing";
---

<Section id="uslugi">
	<SectionHeading
		eyebrow="Usługi"
		heading="Wszystko, czego potrzebuje Twoja firma — w jednym miejscu"
		size="lg"
		headingWidth="lg"
	/>

	<div data-reveal-group class="flex flex-col gap-3.5 md:gap-4">
		<ServiceFeatureCard />

		<div class="grid gap-3.5 md:grid-cols-3 md:gap-4">
			<ServiceCard
				icon="users"
				heading="Kadry i płace"
				description="Listy płac, umowy, akta osobowe, ZUS, PPK i PFRON — dla pracowników i zleceniobiorców."
			>
				<div class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4">
					<div class="flex items-center gap-2.5">
						<span class="grid h-7.5 w-7.5 place-items-center rounded-full bg-surface-tint text-[11px] font-extrabold text-accent">
							KN
						</span>
						<div class="min-w-0 flex-1">
							<div class="text-[12.5px] font-bold">Katarzyna N.</div>
							<div class="text-[11px] text-muted-100">Umowa o pracę</div>
						</div>
					</div>
					<div class="h-px bg-border-2"></div>
					<div class="flex justify-between text-[12.5px]">
						<span class="font-semibold text-muted-100">ZUS</span>
						<span class="font-bold text-success">wysłane ✓</span>
					</div>
				</div>
			</ServiceCard>

			<ServiceCard
				icon="plus"
				heading="Zakładanie działalności"
				description="Wybór kodów PKD, rejestracja w CEIDG i zgłoszenia do ZUS — rozliczenia prowadzę zgodnie z wybraną formą opodatkowania."
			>
				<div class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4">
					<ServiceChecklistItem label="Kody PKD" />
					<ServiceChecklistItem label="Wniosek CEIDG" />
					<ServiceChecklistItem label="Założenie firmy w cenie" />
				</div>
			</ServiceCard>

			<ServiceCard
				icon="file-text"
				heading="Rozliczenia roczne PIT"
				description="Roczne zeznanie PIT-37, PIT-36 czy PIT-28 — także dla osób bez stałej obsługi. Ulgi i odliczenia policzę za Ciebie."
			>
				<div class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4">
					<div class="flex items-center justify-between">
						<span class="text-[12.5px] font-bold">PIT-37 · 2025</span>
						<span class="text-[12px] font-bold text-success">złożony ✓</span>
					</div>
					<div class="h-px bg-border-2"></div>
					<div class="flex justify-between text-[12.5px]">
						<span class="font-semibold text-muted-100">Cena</span>
						<span class="font-bold">od {pricing.pit.priceFrom} zł</span>
					</div>
				</div>
			</ServiceCard>
		</div>

		<ServiceCta />
	</div>
</Section>
