---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import IconTile from "../ui/IconTile.astro";
---

<Section id="uslugi">
	<SectionHeading
		eyebrow="Usługi"
		heading="Wszystko, czego potrzebuje Twoja firma — w jednym miejscu"
		size="lg"
		headingWidth="lg"
	/>

	<div data-reveal-group class="flex flex-col gap-3.5 md:grid md:grid-cols-4 md:auto-rows-[minmax(150px,auto)] md:gap-4 lg:auto-rows-[minmax(168px,auto)]">
		<!-- BIG: Prowadzenie JDG -->
		<div
			data-reveal
			class="relative col-span-2 row-span-2 flex flex-col overflow-hidden rounded-3xl bg-linear-to-br from-muted-900 to-muted-800 p-[clamp(26px,2.6vw,38px)] text-white"
		>
			<div
				class="pointer-events-none absolute -top-10 -right-10 h-55 w-55 rounded-full bg-[radial-gradient(circle,rgba(123,108,246,0.4),transparent_70%)]"
			>
			</div>
			<IconTile
				icon="briefcase"
				size="md"
				tone="soft"
				iconSize={22}
				iconStrokeWidth={1.8}
				class="mb-5"
			/>
			<h3 class="text-[clamp(24px,2.6vw,32px)] tracking-[-0.02em]">Prowadzenie JDG</h3>
			<p class="mt-3 max-w-[38ch] text-[15.5px] leading-[1.6] text-white/68">
				Kompleksowe rozliczenia jednoosobowej działalności gospodarczej. Pomoc w wyborze formy opodatkowania. Składanie deklaracji ZUS. Kontakt z urzędem skarbowym, ZUS. Wsparcie w przypadku kontroli. Niczym się nie stresujesz. 
			</p>
			<div class="mt-5 flex flex-wrap gap-2">
				{
					["Zasady ogólne", "Podatek liniowy", "Ryczałt"].map((tag) => (
						<span class="rounded-full border border-white/12 bg-white/8 px-3.5 py-1.5 text-[13px] font-semibold">
							{tag}
						</span>
					))
				}
			</div>
			<div class="mt-auto pt-6.5">
				<div class="rounded-2xl border border-white/10 bg-white/5.5 p-4.5">
					<div class="flex items-center justify-between">
						<span class="text-sm font-bold">Faktura FV/2026/03</span>
						<span class="rounded-full bg-success-mint/12 px-2.5 py-1 text-[11px] font-bold text-success-mint">
							rozliczona
						</span>
					</div>
					<div class="mt-3.5 flex gap-2.5">
						<div class="flex-1 rounded-xl bg-white/5 p-3">
							<div class="text-[11px] font-semibold text-white/50">Ryczałt 8,5%</div>
							<div class="mt-0.5 font-display text-xl font-extrabold">357 zł</div>
						</div>
						<div class="flex-1 rounded-xl bg-white/5 p-3">
							<div class="text-[11px] font-semibold text-white/50">Liniowy 19%</div>
							<div class="mt-0.5 font-display text-xl font-extrabold">798 zł</div>
						</div>
					</div>
				</div>
			</div>
		</div>

		<!-- stat -->
		<div
			data-reveal
			class="flex flex-col justify-center rounded-3xl border border-border-2 bg-white p-[clamp(22px,2.2vw,30px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.25)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.28)]"
		>
			<div
				class="bg-linear-to-r from-accent to-accent-3 bg-clip-text font-display text-[clamp(30px,3.2vw,44px)] font-extrabold tracking-[-0.03em] text-transparent"
			>
				od <span data-count-to="250">250</span> zł
			</div>
			<div class="mt-1 text-sm font-medium text-muted-400">miesięcznie za prowadzenie JDG</div>
		</div>

		<!-- stat -->
		<div
			data-reveal
			class="flex flex-col justify-center rounded-3xl border border-border-2 bg-white p-[clamp(22px,2.2vw,30px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.25)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.28)]"
		>
			<div
				class="bg-linear-to-r from-accent to-accent-3 bg-clip-text font-display text-[clamp(30px,3.2vw,44px)] font-extrabold tracking-[-0.03em] text-transparent"
			>
				<span data-count-to="100">100</span>%
			</div>
			<div class="mt-1 text-sm font-medium text-muted-400">obsługi zdalnej, w całej Polsce</div>
		</div>

		<!-- Zakładanie JDG (wide) -->
		<div
			data-reveal
			class="col-span-2 flex flex-col gap-5 rounded-3xl border border-border-2 bg-white p-[clamp(24px,2.4vw,34px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.22)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.26)] md:flex-row md:items-center md:gap-6"
		>
			<div class="min-w-0 flex-1">
				<IconTile
					icon="plus"
					size="md"
					iconSize={22}
					iconStrokeWidth={1.9}
					class="mb-4"
				/>
				<h3 class="text-[clamp(21px,2.2vw,26px)] tracking-[-0.02em]">Zakładanie JDG</h3>
				<p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted-400">
					Wybór PKD, formy opodatkowania, rejestracja w CEIDG i zgłoszenia do ZUS. Bez błędów,
					które później kosztują.
				</p>
			</div>
			<div
				class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4 md:w-47.5 md:shrink-0"
			>
				<div class="flex items-center gap-2.5">
					<span class="grid h-5.5 w-5.5 place-items-center rounded-full bg-success text-[12px] font-extrabold text-white">
						✓
					</span>
					<span class="text-[13px] font-semibold">Kody PKD</span>
				</div>
				<div class="flex items-center gap-2.5">
					<span class="grid h-5.5 w-5.5 place-items-center rounded-full bg-success text-[12px] font-extrabold text-white">
						✓
					</span>
					<span class="text-[13px] font-semibold">Wniosek CEIDG</span>
				</div>
				<div class="flex items-center gap-2.5">
					<span class="grid h-5.5 w-5.5 place-items-center rounded-full bg-success text-[12px] font-extrabold text-white">
						✓
					</span>
					<span class="text-[13px] font-semibold">Założenie firmy w cenie</span>
				</div>
				
			</div>
		</div>

		<!-- Kadry i płace (wide) -->
		<div
			data-reveal
			class="col-span-2 flex flex-col gap-5 rounded-3xl border border-border-2 bg-white p-[clamp(24px,2.4vw,34px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.22)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.26)] md:flex-row md:items-center md:gap-6"
		>
			<div class="min-w-0 flex-1">
				<IconTile
					icon="users"
					size="md"
					iconSize={22}
					iconStrokeWidth={1.9}
					class="mb-4"
				/>
				<h3 class="text-[clamp(21px,2.2vw,26px)] tracking-[-0.02em]">Kadry i&nbsp;płace</h3>
				<p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted-400">
					Listy płac, umowy, akta osobowe, ZUS, PPK i PFRON — dla pracowników i zleceniobiorców.
				</p>
			</div>
			<div
				class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4 md:w-47.5 md:shrink-0"
			>
				<div class="flex items-center gap-2.5">
					<span class="grid h-7.5 w-7.5 place-items-center rounded-full bg-surface-tint text-[11px] font-extrabold text-accent">
						KN
					</span>
					<div class="min-w-0 flex-1">
						<div class="text-[12.5px] font-bold">Katarzyna N.</div>
						<div class="text-[11px] text-muted-100">Umowa o pracę</div>
					</div>
				</div>
				<div class="h-px bg-border-2"></div>
				<div class="flex justify-between text-[12.5px]">
					<span class="font-semibold text-muted-100">ZUS</span>
					<span class="font-bold text-success">wysłane ✓</span>
				</div>
			</div>
		</div>

		<!-- Rozliczenia roczne PIT (wide) -->
		<div
			data-reveal
			class="col-span-2 flex flex-col gap-5 rounded-3xl border border-border-2 bg-white p-[clamp(24px,2.4vw,34px)] shadow-[0_12px_30px_-24px_rgba(11,11,18,0.22)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_24px_44px_-26px_rgba(11,11,18,0.26)] md:flex-row md:items-center md:gap-6"
		>
			<div class="min-w-0 flex-1">
				<IconTile
					icon="file-text"
					size="md"
					iconSize={22}
					iconStrokeWidth={1.9}
					class="mb-4"
				/>
				<h3 class="text-[clamp(21px,2.2vw,26px)] tracking-[-0.02em]">Rozliczenia roczne PIT</h3>
				<p class="mt-2.5 text-[14.5px] leading-[1.55] text-muted-400">
					Roczne zeznanie PIT-37, PIT-36 czy PIT-28 — także dla osób bez stałej obsługi. Ulgi i
					odliczenia policzę za Ciebie.
				</p>
			</div>
			<div
				class="flex w-full flex-col gap-3 rounded-2xl border border-border-2 bg-[#F7F8FC] p-4 md:w-47.5 md:shrink-0"
			>
				<div class="flex items-center justify-between">
					<span class="text-[12.5px] font-bold">PIT-37 · 2025</span>
					<span class="text-[12px] font-bold text-success">złożony ✓</span>
				</div>
				<div class="h-px bg-border-2"></div>
				<div class="flex justify-between text-[12.5px]">
					<span class="font-semibold text-muted-100">Cena</span>
					<span class="font-bold">od 100 zł</span>
				</div>
			</div>
		</div>

		<!-- CTA (wide) -->
		<a
			href="#kontakt"
			data-reveal
			class="group relative col-span-4 flex items-center gap-6 overflow-hidden rounded-3xl bg-linear-to-br from-accent to-accent-2 p-[clamp(24px,2.4vw,34px)] text-white shadow-[0_18px_40px_-24px_rgba(79,91,242,0.7)] transition-all duration-250 hover:-translate-y-1 hover:shadow-[0_28px_50px_-24px_rgba(79,91,242,0.85)]"
		>
			<div class="pointer-events-none absolute -top-10 -right-10 h-40 w-40 rounded-full bg-white/10"></div>
			<div class="relative min-w-0 flex-1">
				<h3 class="text-[clamp(21px,2.2vw,26px)] tracking-[-0.02em]">Nie widzisz swojej usługi?</h3>
				<p class="mt-2.5 max-w-[34ch] text-[14.5px] leading-[1.55] text-white/80">
					Napisz — dobiorę zakres obsługi do Twojej działalności i wycenię ją na bezpłatnej
					konsultacji.
				</p>
			</div>
			<span
				class="relative grid h-12 w-12 shrink-0 place-items-center rounded-full bg-white/15 text-2xl leading-none transition-transform duration-250 group-hover:translate-x-1"
			>
				→
			</span>
		</a>
	</div>
</Section>

<script>
	// Count-up: odlicza `[data-count-to]` od 0 do wartości docelowej przy
	// wejściu w viewport (raz). Reduced-motion → od razu wartość końcowa.
	const counters = document.querySelectorAll<HTMLElement>("[data-count-to]");

	if (counters.length) {
		const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

		const run = (el: HTMLElement) => {
			const target = Number(el.dataset.countTo);
			if (!Number.isFinite(target)) return;
			if (reduce) {
				el.textContent = String(target);
				return;
			}
			const DURATION = 1200;
			const start = performance.now();
			el.textContent = "0";
			const tick = (now: number) => {
				const t = Math.min(1, (now - start) / DURATION);
				const eased = 1 - Math.pow(1 - t, 3); // easeOutCubic
				el.textContent = String(Math.round(eased * target));
				if (t < 1) requestAnimationFrame(tick);
			};
			requestAnimationFrame(tick);
		};

		const observer = new IntersectionObserver(
			(entries, obs) => {
				for (const entry of entries) {
					if (!entry.isIntersecting) continue;
					run(entry.target as HTMLElement);
					obs.unobserve(entry.target);
				}
			},
			{ threshold: 0.6 },
		);

		counters.forEach((el) => observer.observe(el));
	}
</script>
