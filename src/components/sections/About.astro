---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";

interface TimelineEntry {
	year: string;
	title: string;
	org: string;
}

const timeline: TimelineEntry[] = [
	{
		year: "2021",
		title: "Licencjat — finanse i rachunkowość spółek",
		org: "Uniwersytet Ekonomiczny we Wrocławiu",
	},
	{
		year: "2022",
		title: "Kurs kadrowo-płacowy",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2023",
		title: "Magister — specjalizacja doradztwo podatkowe",
		org: "Uniwersytet Ekonomiczny we Wrocławiu",
	},
	{
		year: "2025",
		title: "I stopień certyfikacji zawodu księgowego",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2025",
		title: "Zaawansowany kurs Kadry i Płace",
		org: "Fundacja Rozwoju Rachunkowości",
	},
	{
		year: "2026",
		title: "Specjalista ds. środków trwałych",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2026",
		title: "II stopień specjalista ds. rachunkowości",
		org: "Stowarzyszenie Księgowych w Polsce",
	}
];

const badges = ["Certyfikat SKwP II stopień", "Specjalista ds. kadr i płac", "Specjalista ds. środków trwałych"];

interface Highlight {
	label: string;
	title: string;
	org: string;
}

const highlights: Highlight[] = [
	{
		label: "Wykształcenie",
		title: "Magister Uniwersytetu Ekonomicznego we Wrocławiu",
		org: "Rachunkowość i controlling",
	},
	{
		label: "Księgowość",
		title: "Certyfikacja Stowarzyszenia Księgowych w Polsce, II stopień",
		org: "Specjalista ds. rachunkowości",
	},
	{
		label: "Kadry i specjalizacje",
		title: "Kadry i płace oraz specjalista ds. środków trwałych",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
];
---

<Section id="o-mnie">
	<div class="grid items-start gap-8 md:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] md:gap-[clamp(40px,5vw,80px)]">
		<div data-reveal>
			<SectionHeading
				eyebrow="O mnie"
				heading="Aleksandra Potocka"
				variant="inline"
				size="md"
				headingWidth="none"
			/>
			<p class="mt-5.5 max-w-[44ch] text-base leading-[1.65] text-muted-600">
				Jestem magistrem Uniwersytetu Ekonomicznego we Wrocławiu — kierunek rachunkowość i controlling, ze specjalizacją doradztwo podatkowe. Od sześciu lat pracuję w biurach
				rachunkowych i działach kadr: od KPiR i ksiąg handlowych, przez rozliczenia VAT, po pełną
				obsługę kadrowo-płacową.
			</p>
			<p class="mt-4 max-w-[44ch] text-base leading-[1.65] text-muted-600">
				Nieustannie rozwijam swoje kompetencje, aby pracować w oparciu o aktualną wiedzę i obowiązujące regulacje. Zmiany w przepisach śledzę na bieżąco.
			</p>
			<div class="mt-6.5 flex flex-wrap gap-2.5">
				{
					badges.map((badge) => (
						<span class="rounded-full bg-surface-tint px-3.5 py-2 text-[13.5px] font-bold text-link">
							{badge}
						</span>
					))
				}
			</div>
		</div>
		<div data-reveal-group class="rounded-3xl border border-border-2 bg-white p-[clamp(22px,2.4vw,36px)] shadow-[0_20px_44px_-30px_rgba(11,11,18,0.3)]">
			<div class="mb-1.5 text-[12.5px] font-bold tracking-[0.7px] text-muted-100 uppercase">
				Wykształcenie i certyfikaty
			</div>
			{
				highlights.map((item) => (
					<div data-reveal class="grid grid-cols-[56px_1fr] gap-4.5 not-last:border-b not-last:border-border-4 py-4">
						<div class="text-[11px] font-bold tracking-[0.4px] text-accent uppercase">{item.label}</div>
						<div>
							<div class="text-[15px] font-bold leading-[1.3]">{item.title}</div>
							<div class="mt-0.5 text-[13px] text-muted-300">{item.org}</div>
						</div>
					</div>
				))
			}

			<details class="group mt-4">
				<summary class="flex cursor-pointer list-none items-center gap-2 text-[13.5px] font-bold text-link">
					Zobacz wszystkie kwalifikacje
					<span class="transition-transform duration-200 group-open:rotate-180" aria-hidden="true">▾</span>
				</summary>
				<div class="mt-2">
					{
						timeline.map((entry) => (
							<div class="grid grid-cols-[56px_1fr] gap-4.5 not-last:border-b not-last:border-border-4 py-4">
								<div class="font-display text-[15px] font-extrabold text-accent">{entry.year}</div>
								<div>
									<div class="text-[15px] font-bold leading-[1.3]">{entry.title}</div>
									<div class="mt-0.5 text-[13px] text-muted-300">{entry.org}</div>
								</div>
							</div>
						))
					}
				</div>
			</details>
		</div>
	</div>
</Section>
