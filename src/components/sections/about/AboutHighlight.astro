---
interface Props {
	label: string;
	title: string;
	org: string;
}

const { label, title, org } = Astro.props;
---

<div data-reveal class="not-last:border-b not-last:border-border-4 py-4">
	<div class="text-[11px] font-bold tracking-[0.4px] text-accent uppercase">{label}</div>
	<div class="mt-1 text-[15px] font-bold leading-[1.3]">{title}</div>
	<div class="mt-0.5 text-[13px] text-muted-300">{org}</div>
</div>
