---
import AboutHighlight from "./AboutHighlight.astro";
import AboutTimelineItem from "./AboutTimelineItem.astro";

export interface TimelineEntry {
	year: string;
	title: string;
	org: string;
}

export interface Highlight {
	label: string;
	title: string;
	org: string;
}

interface Props {
	highlights: Highlight[];
	timeline: TimelineEntry[];
}

const { highlights, timeline } = Astro.props;
---

{/*
  Karta jest jednocześnie celem animacji (`data-reveal="right"` — wjeżdża
  z prawej, naprzeciw kolumny tekstu) i grupą staggerującą swoje wyróżnienia.
  scrollReveal obsługuje oba atrybuty na jednym węźle: element trafia do listy
  grup, a stagger dotyczy wyłącznie potomków.
*/}
<div
	data-reveal="right"
	data-reveal-group
	class="rounded-3xl border border-border-2 bg-white p-[clamp(22px,2.4vw,36px)] shadow-[0_20px_44px_-30px_rgba(11,11,18,0.3)]"
>
	<div class="mb-1.5 text-[12.5px] font-bold tracking-[0.7px] text-muted-100 uppercase">
		Wykształcenie i certyfikaty
	</div>
	{highlights.map((item) => <AboutHighlight label={item.label} title={item.title} org={item.org} />)}

	{/*
		Wpisy siedzą w zwiniętym <details>, więc obserwator scrolla nigdy by ich
		nie zobaczył — animacja osi i wierszy wisi na `[open]` (global.css) i
		odtwarza się przy każdym rozwinięciu.
	*/}
	<details data-about-more class="group mt-4">
		<summary class="flex cursor-pointer list-none items-center gap-2 text-[13.5px] font-bold text-link">
			Zobacz wszystkie kwalifikacje
			<span class="transition-transform duration-200 group-open:rotate-180" aria-hidden="true">▾</span>
		</summary>
		<div class="mt-2">
			{
				timeline.map((entry, i) => (
					<AboutTimelineItem
						year={entry.year}
						title={entry.title}
						org={entry.org}
						index={i}
						isLast={i === timeline.length - 1}
					/>
				))
			}
		</div>
	</details>
</div>
