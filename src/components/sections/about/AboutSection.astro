---
import Section from "../../ui/Section.astro";
import SectionHeading from "../../ui/SectionHeading.astro";
import AboutBadge from "./AboutBadge.astro";
import AboutCredentials, { type Highlight, type TimelineEntry } from "./AboutCredentials.astro";

const timeline: TimelineEntry[] = [
	{
		year: "2021",
		title: "Licencjat — finanse i rachunkowość spółek",
		org: "Uniwersytet Ekonomiczny we Wrocławiu",
	},
	{
		year: "2022",
		title: "Kurs kadrowo-płacowy",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2023",
		title: "Magister — specjalizacja doradztwo podatkowe",
		org: "Uniwersytet Ekonomiczny we Wrocławiu",
	},
	{
		year: "2025",
		title: "I stopień certyfikacji zawodu księgowego",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2025",
		title: "Zaawansowany kurs Kadry i Płace",
		org: "Fundacja Rozwoju Rachunkowości",
	},
	{
		year: "2026",
		title: "Specjalista ds. środków trwałych",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
	{
		year: "2026",
		title: "II stopień specjalista ds. rachunkowości",
		org: "Stowarzyszenie Księgowych w Polsce",
	}
];

const badges = ["Certyfikat SKwP II stopień", "Specjalista ds. kadr i płac", "Specjalista ds. środków trwałych"];

const highlights: Highlight[] = [
	{
		label: "Wykształcenie",
		title: "Magister Uniwersytetu Ekonomicznego we Wrocławiu",
		org: "Rachunkowość i controlling",
	},
	{
		label: "Księgowość",
		title: "Certyfikacja Stowarzyszenia Księgowych w Polsce, II stopień",
		org: "Specjalista ds. rachunkowości",
	},
	{
		label: "Kadry i specjalizacje",
		title: "Kadry i płace oraz specjalista ds. środków trwałych",
		org: "Stowarzyszenie Księgowych w Polsce",
	},
];
---

<Section id="o-mnie">
	<div class="grid items-start gap-8 md:grid-cols-[minmax(0,0.92fr)_minmax(0,1.08fr)] md:gap-[clamp(40px,5vw,80px)]">
		{/* Kolumny stoją obok siebie, więc każda wjeżdża ze swojej strony. Poniżej
		    `md` układ się składa i CSS sam wraca do ruchu z dołu. */}
		<div data-reveal="left">
			<SectionHeading
				eyebrow="O mnie"
				heading="Aleksandra Potocka"
				variant="inline"
				size="md"
				headingWidth="none"
			/>
			<p class="mt-5.5 max-w-[44ch] text-base leading-[1.65] text-muted-600">
				Jestem magistrem Uniwersytetu Ekonomicznego we Wrocławiu — kierunek rachunkowość i controlling, ze specjalizacją doradztwo podatkowe. Od sześciu lat pracuję w biurach
				rachunkowych i działach kadr: od KPiR i ksiąg handlowych, przez rozliczenia VAT, po pełną
				obsługę kadrowo-płacową.
			</p>
			<p class="mt-4 max-w-[44ch] text-base leading-[1.65] text-muted-600">
				Nieustannie rozwijam swoje kompetencje, aby pracować w oparciu o aktualną wiedzę i obowiązujące regulacje. Zmiany w przepisach śledzę na bieżąco.
			</p>
			<div class="mt-6.5 flex flex-wrap gap-2.5">
				{badges.map((badge) => <AboutBadge label={badge} />)}
			</div>
		</div>
		<AboutCredentials highlights={highlights} timeline={timeline} />
	</div>
</Section>
