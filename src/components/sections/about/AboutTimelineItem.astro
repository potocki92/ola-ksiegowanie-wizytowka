---
interface Props {
	year: string;
	title: string;
	org: string;
}

const { year, title, org } = Astro.props;
---

<div class="grid grid-cols-[56px_1fr] gap-4.5 not-last:border-b not-last:border-border-4 py-4">
	<div class="font-display text-[15px] font-extrabold text-accent">{year}</div>
	<div>
		<div class="text-[15px] font-bold leading-[1.3]">{title}</div>
		<div class="mt-0.5 text-[13px] text-muted-300">{org}</div>
	</div>
</div>
