---
import Section from "../ui/Section.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import Button from "../ui/Button.astro";
import IconTile from "../ui/IconTile.astro";
---

<Section
	id="kontakt"
	padding="none"
	class="px-[clamp(18px,4vw,56px)] py-[clamp(40px,6vw,96px)]"
>
	<div
		class="relative overflow-hidden rounded-[clamp(24px,3vw,36px)] bg-linear-to-br from-muted-900 to-ink p-[clamp(28px,4vw,72px)] text-white"
	>
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(45%_55%_at_90%_0%,rgba(123,108,246,0.28),transparent_70%)]"
		>
		</div>
		<div class="relative grid gap-8 md:grid-cols-2 md:gap-[clamp(40px,5vw,72px)]">
			<div>
				<SectionHeading
					eyebrow="Kontakt"
					heading="Zacznijmy od bezpłatnej rozmowy"
					tone="dark"
					variant="inline"
					headingWidth="none"
					leadWidth="max-w-[40ch]"
					leadClass="text-[16.5px]"
					headingClass="text-[clamp(30px,4.6vw,54px)] leading-[1.02] tracking-[-0.03em]"
					lead="Opowiedz mi w kilku zdaniach o swojej działalności. Odezwę się z konkretną wyceną i propozycją formy opodatkowania — bez zobowiązań."
				/>
				<div class="mt-[clamp(28px,3.4vw,40px)] flex flex-col gap-3.5">
					<a href="tel:+48533032455" class="flex items-center gap-3.5 text-white">
						<IconTile
							icon="phone"
							size="h-11.5 w-11.5"
							radius="rounded-[13px]"
							bg="bg-accent-soft/14"
							iconClass="text-accent-soft"
							iconSize={20}
							iconStrokeWidth={1.8}
						/>
						<span>
							<span class="block text-xs tracking-[0.5px] text-white/55 uppercase">Telefon</span>
							<span class="font-display text-[19px] font-bold">533 032 455</span>
						</span>
					</a>
					<a href="mailto:a.potocka.rozliczenia@gmail.com" class="flex items-center gap-3.5 text-white">
						<IconTile
							icon="mail"
							size="h-11.5 w-11.5"
							radius="rounded-[13px]"
							bg="bg-accent-soft/14"
							iconClass="text-accent-soft"
							iconSize={20}
							iconStrokeWidth={1.8}
						/>
						<span class="min-w-0">
							<span class="block text-xs tracking-[0.5px] text-white/55 uppercase">E-mail</span>
							<span class="font-display text-[19px] font-bold break-all">a.potocka.rozliczenia@gmail.com</span>
						</span>
					</a>
					<div class="flex items-center gap-3.5">
						<IconTile
							icon="map-pin"
							size="h-11.5 w-11.5"
							radius="rounded-[13px]"
							bg="bg-accent-soft/14"
							iconClass="text-accent-soft"
							iconSize={20}
							iconStrokeWidth={1.8}
						/>
						<span>
							<span class="block text-xs tracking-[0.5px] text-white/55 uppercase">Zasięg</span>
							<span class="font-display text-[19px] font-bold">Jelenia Góra, Bolesławiec · online, cała Polska</span>
						</span>
					</div>
				</div>
			</div>

			<form
				id="contact-form"
				class="flex flex-col gap-3.5 rounded-[20px] border border-white/13 bg-white/5 p-[clamp(22px,3vw,34px)]"
			>
				<label class="flex flex-col gap-1.5">
					<span class="text-[13px] font-semibold text-white/72">Imię i nazwisko</span>
					<input
						type="text"
						name="name"
						required
						autocomplete="name"
						placeholder="Jan Kowalski"
						class="h-12.5 rounded-xl border border-white/18 bg-white/6 px-4 font-[inherit] text-[15px] text-white outline-none transition-[border-color,box-shadow] duration-200"
					/>
				</label>
				<label class="flex flex-col gap-1.5">
					<span class="text-[13px] font-semibold text-white/72">E-mail lub telefon</span>
					<input
						type="text"
						name="contact"
						required
						autocomplete="email"
						placeholder="jan@firma.pl"
						class="h-12.5 rounded-xl border border-white/18 bg-white/6 px-4 font-[inherit] text-[15px] text-white outline-none transition-[border-color,box-shadow] duration-200"
					/>
				</label>
				<label class="flex flex-col gap-1.5">
					<span class="text-[13px] font-semibold text-white/72">Czego potrzebujesz?</span>
					<textarea
						name="message"
						rows="4"
						placeholder="Np. zakładam JDG na ryczałcie, chcę przejść na Twoją obsługę…"
						class="resize-y rounded-xl border border-white/18 bg-white/6 px-4 py-3.5 font-[inherit] text-[15px] text-white outline-none transition-[border-color,box-shadow] duration-200"
					></textarea>
				</label>
				<Button
					type="submit"
					variant="primary"
					class="mt-1 h-13.5 font-[inherit]"
				>
					Wyślij zapytanie
				</Button>
				<p data-form-note class="text-center text-xs text-white/50">
					Wysyłając formularz akceptujesz przetwarzanie danych w celu kontaktu.
				</p>
			</form>
		</div>
	</div>
</Section>

<script>
	const form = document.getElementById("contact-form") as HTMLFormElement | null;
	const note = form?.querySelector<HTMLParagraphElement>("[data-form-note]");
	const defaultNote = note?.textContent ?? "";

	form?.addEventListener("submit", (e) => {
		e.preventDefault();
		form.reset();
		if (note) note.textContent = "Dziękuję! Odezwę się najszybciej jak to możliwe.";
		window.setTimeout(() => {
			if (note) note.textContent = defaultNote;
		}, 6000);
	});
</script>
