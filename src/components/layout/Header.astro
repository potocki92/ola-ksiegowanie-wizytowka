---
import BrandLockup from "../ui/BrandLockup.astro";
import Button from "../ui/Button.astro";

const navLinks = [
	{ id: "uslugi", label: "Usługi" },
	{ id: "o-mnie", label: "O mnie" },
	{ id: "cennik", label: "Cennik" },
	{ id: "faq", label: "FAQ" },
];

// Sekcje istnieją tylko na stronie głównej. Na podstronach (np. polityce
// prywatności) gołe `#uslugi` nie prowadziłoby donikąd, więc kotwice dostają
// prefiks ścieżki. `data-nav-link` zostaje samym id — scrollspy niżej opiera
// się na nim i prefiks by go rozstroił.
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---

<header class="sticky top-0 z-60">
	{/* `data-navbar` siedzi na `nav`, a nie na `header`, bo to `nav` niesie tło
	    i obramowanie — `.is-scrolled` podmienia właśnie je. */}
	<nav
		data-navbar
		class="flex items-center justify-between px-[clamp(18px,4vw,56px)] py-3.5 bg-bg/78 backdrop-blur-xl border-b border-black/6"
	>
		<BrandLockup href={isHome ? "#top" : "/"} size="lg" />

		<div class="hidden md:flex items-center gap-4.5 lg:gap-7.5">
			{/*
				Linki dostają własny kontener `relative`, bo wskaźnik aktywnej sekcji
				pozycjonuje się względem NIEGO, a nie całego paska — przycisk CTA stoi
				obok i nie może wchodzić w rachubę offsetów.
			*/}
			<div data-nav-track class="relative flex items-center gap-4.5 lg:gap-7.5">
				{
					navLinks.map((link) => (
						<a
							href={anchor(link.id)}
							data-nav-link={link.id}
							class="nav-link text-[14.5px] font-semibold text-muted-700 transition-colors duration-200 hover:text-ink"
						>
							{link.label}
						</a>
					))
				}
				<span data-nav-indicator aria-hidden="true"></span>
			</div>
			<Button href={anchor("kontakt")} variant="nav">Bezpłatna konsultacja</Button>
		</div>

		<button
			id="menu-toggle"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="mobile-drawer"
			class="grid h-11 w-11 place-items-center rounded-xl bg-surface-2 md:hidden"
		>
			<span class="burger" aria-hidden="true">
				<span class="burger-line"></span>
				<span class="burger-line"></span>
				<span class="burger-line"></span>
			</span>
		</button>
	</nav>

	{/* `--i` = miejsce w kolejce; panel wjeżdżał wcześniej w całości, więc linki
	    „były już na miejscu" zanim zdążył się rozwinąć. */}
	<div id="mobile-drawer" class="drawer md:hidden" aria-hidden="true" inert>
		<div class="drawer-inner">
			<nav class="flex flex-col gap-1.5 px-[clamp(18px,4vw,56px)] pt-2" aria-label="Menu mobilne">
				{
					navLinks.map((link, i) => (
						<a
							href={anchor(link.id)}
							data-menu-link
							data-nav-link={link.id}
							style={`--i:${i}`}
							class="drawer-link nav-link border-b border-border py-3 font-display text-[30px] font-bold text-ink"
						>
							{link.label}
						</a>
					))
				}
				<a
					href={anchor("kontakt")}
					data-menu-link
					style={`--i:${navLinks.length}`}
					class="drawer-link btn-press mt-2 mb-6 flex h-14 items-center justify-center rounded-2xl bg-linear-to-br from-accent to-accent-2 text-[17px] font-bold text-white shadow-[0_16px_30px_-14px_rgba(47,68,104,0.5)] transition-transform duration-200"
				>
					Umów bezpłatną konsultację
				</a>
			</nav>
		</div>
	</div>
</header>

<div
	id="menu-backdrop"
	class="drawer-backdrop fixed inset-0 z-58 bg-black/40 md:hidden"
	aria-hidden="true"
>
</div>

<script>
	import { onPageInit } from "../../lib/pageInit";

	// Panel żyje tylko w obrębie jednej strony, a po przejściu przez ClientRouter
	// wszystkie te węzły są już inne — stąd wiązanie w `onPageInit`.
	let toggleBtn: HTMLElement | null = null;
	let drawer: HTMLElement | null = null;
	let backdrop: HTMLElement | null = null;
	let isOpen = false;

	function openMenu() {
		if (!toggleBtn || !drawer || !backdrop) return;
		isOpen = true;
		drawer.inert = false;
		drawer.removeAttribute("aria-hidden");
		drawer.classList.add("is-open");
		backdrop.classList.add("is-open");
		toggleBtn.setAttribute("aria-expanded", "true");
		document.body.style.overflow = "hidden";
		drawer.querySelector<HTMLAnchorElement>("[data-menu-link]")?.focus();
	}

	// `transitionend` bąbelkuje z dzieci `.drawer-link` (mają własne przejścia
	// opacity/transform), więc naiwny listener `{ once: true }` na `drawer`
	// zużyłby się na pierwszym zdarzeniu dziecka zamiast doczekać przejścia
	// `grid-template-rows` samego panelu. Filtr po target+property i ręczne
	// usuwanie listenera to omijają, a ta sama referencja funkcji sprawia, że
	// powtórne `addEventListener` (szybkie zamknij/zamknij) nic nie psuje.
	function onDrawerCollapsed(e: TransitionEvent) {
		if (!drawer) return;
		if (e.target !== drawer || e.propertyName !== "grid-template-rows" || isOpen) return;
		drawer.inert = true;
		drawer.setAttribute("aria-hidden", "true");
		drawer.removeEventListener("transitionend", onDrawerCollapsed);
	}

	function closeMenu({ returnFocus = true }: { returnFocus?: boolean } = {}) {
		if (!isOpen || !toggleBtn || !drawer || !backdrop) return;
		isOpen = false;
		drawer.classList.remove("is-open");
		backdrop.classList.remove("is-open");
		toggleBtn.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
		if (returnFocus) toggleBtn.focus();
		drawer.addEventListener("transitionend", onDrawerCollapsed);
	}

	// Listener dokumentu rejestrujemy raz, w zasięgu modułu. Gdyby siedział
	// w `onPageInit`, każde przejście między stronami dokładałoby kolejny.
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && isOpen) closeMenu();
	});

	onPageInit(() => {
		toggleBtn = document.getElementById("menu-toggle");
		drawer = document.getElementById("mobile-drawer");
		backdrop = document.getElementById("menu-backdrop");
		if (!toggleBtn || !drawer || !backdrop) return;

		// Nowy dokument przychodzi z zamkniętym panelem, a nawigacja przy otwartym
		// menu zostawiłaby zablokowany scroll na nowej stronie.
		isOpen = false;
		document.body.style.overflow = "";

		toggleBtn.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
		backdrop.addEventListener("click", () => closeMenu());
		drawer
			.querySelectorAll<HTMLAnchorElement>("[data-menu-link]")
			.forEach((link) => link.addEventListener("click", () => closeMenu({ returnFocus: false })));
	});
</script>

<script>
	import { onPageInit } from "../../lib/pageInit";

	// Scrollspy: podświetla link sekcji widocznej na ekranie, przesuwa pod nim
	// wspólną kreskę i unosi pasek po zejściu ze szczytu strony. Wszystko trzy
	// razem, bo i tak liczą się przy tym samym zdarzeniu scrolla — trzy osobne
	// listenery robiłyby tę samą pracę trzykrotnie.
	const LINE = 100; // px poniżej górnej krawędzi (mija przyklejony pasek)
	const ELEVATE_AT = 8; // px scrolla, po których pasek dostaje cień

	let navLinks: HTMLAnchorElement[] = [];
	let sections: HTMLElement[] = [];
	let navbar: HTMLElement | null = null;
	let track: HTMLElement | null = null;
	let indicator: HTMLElement | null = null;

	function moveIndicator(currentId: string | null) {
		if (!indicator || !track) return;

		const active = currentId
			? track.querySelector<HTMLElement>(`[data-nav-link="${currentId}"]`)
			: null;

		// Poza sekcjami z menu (góra strony, stopka, podstrony) kreski nie ma —
		// zostawiamy ją tam, gdzie była, i tylko wygaszamy, żeby nie odjeżdżała
		// na lewą krawędź przy każdym przewinięciu na sam szczyt.
		if (!active) {
			indicator.style.setProperty("--nav-o", "0");
			return;
		}

		indicator.style.setProperty("--nav-x", `${active.offsetLeft}px`);
		indicator.style.setProperty("--nav-w", `${active.offsetWidth}px`);
		indicator.style.setProperty("--nav-o", "1");
		// Dopiero po pierwszym ustawieniu pozwalamy kresce się przesuwać —
		// inaczej wjechałaby z pozycji zerowej przy pierwszym scrollu.
		indicator.classList.add("is-ready");
	}

	function update() {
		let currentId: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top - LINE <= 0) currentId = section.id;
		}
		for (const link of navLinks) {
			link.classList.toggle("is-active", link.dataset.navLink === currentId);
		}
		moveIndicator(currentId);
		navbar?.classList.toggle("is-scrolled", window.scrollY > ELEVATE_AT);
	}

	let ticking = false;
	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			update();
			ticking = false;
		});
	}

	// Listenery okna rejestrujemy raz, w zasięgu modułu. Gdyby siedziały
	// w `onPageInit`, każde przejście między stronami dokładałoby kolejny.
	window.addEventListener("scroll", onScroll, { passive: true });
	window.addEventListener("resize", onScroll);

	onPageInit(() => {
		navbar = document.querySelector<HTMLElement>("[data-navbar]");
		track = document.querySelector<HTMLElement>("[data-nav-track]");
		indicator = document.querySelector<HTMLElement>("[data-nav-indicator]");
		navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
		sections = [...new Set(navLinks.map((l) => l.dataset.navLink!))]
			.map((id) => document.getElementById(id))
			.filter((el): el is HTMLElement => el !== null)
			.sort((a, b) => a.offsetTop - b.offsetTop);

		update();
	});
</script>

<!-- Pasek celowo NIE zmienia wysokości przy zwijaniu logotypu. `nav` jest
     `sticky`, więc nadal zajmuje miejsce w flow — każda zmiana jego wysokości
     przepycha w trakcie scrolla całą treść pod spodem. Litery logotypu chowają
     się wewnątrz stałej wysokości paska. -->
