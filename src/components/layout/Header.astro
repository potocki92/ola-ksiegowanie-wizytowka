---
import Icon from "../ui/Icon.astro";
import Logo from "../ui/Logo.astro";
import Button from "../ui/Button.astro";

const navLinks = [
	{ href: "#uslugi", label: "Usługi" },
	{ href: "#o-mnie", label: "O mnie" },
	{ href: "#cennik", label: "Cennik" },
	{ href: "#faq", label: "FAQ" },
];
---



<nav
	class="sticky top-0 z-60 flex items-center justify-between px-[clamp(18px,4vw,56px)] py-3.5 bg-bg/78 backdrop-blur-xl border-b border-black/6"
>
	<Logo href="#top" size="md" />

	<div class="hidden md:flex items-center gap-4.5 lg:gap-7.5">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					data-nav-link={link.href.slice(1)}
					class="nav-link nav-underline text-[14.5px] font-semibold text-muted-700 transition-colors duration-200 hover:text-ink"
				>
					{link.label}
				</a>
			))
		}
		<Button href="#kontakt" variant="nav">Bezpłatna konsultacja</Button>
	</div>

	<button
		id="menu-toggle"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="mobile-menu"
		class="grid h-11 w-11 place-items-center rounded-xl bg-[#ece2d4] md:hidden"
	>
		<Icon name="menu" size={24} />
	</button>
</nav>

<div
	id="mobile-menu"
	hidden
	class="fixed inset-0 z-70 flex flex-col bg-bg px-[clamp(18px,4vw,56px)] py-3.5 animate-sheet-up"
>
	<div class="flex items-center justify-between">
		<span class="font-display text-lg font-extrabold">Potocka</span>
		<button
			id="menu-close"
			aria-label="Zamknij"
			class="grid h-11 w-11 place-items-center rounded-xl border-none bg-[#ece2d4]"
		>
			<Icon name="close" size={22} />
		</button>
	</div>
	<div class="mt-8 flex flex-col gap-1.5">
		{
			navLinks.map((link) => (
				<a
					href={link.href}
					data-menu-link
					data-nav-link={link.href.slice(1)}
						class="nav-link border-b border-border py-3 font-display text-[30px] font-bold text-ink"
				>
					{link.label}
				</a>
			))
		}
	</div>
	<a
		href="#kontakt"
		data-menu-link
		class="mt-auto flex h-14 items-center justify-center rounded-2xl bg-linear-to-br from-accent to-accent-2 text-[17px] font-bold text-white shadow-[0_16px_30px_-14px_rgba(107,81,67,0.8)]"
	>
		Umów bezpłatną konsultację
	</a>
</div>

<script>
	const toggleBtn = document.getElementById("menu-toggle")!;
	const closeBtn = document.getElementById("menu-close")!;
	const menu = document.getElementById("mobile-menu")!;
	const menuLinks = menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");

	function openMenu() {
		menu.hidden = false;
		toggleBtn.setAttribute("aria-expanded", "true");
		document.body.style.overflow = "hidden";
	}

	function closeMenu() {
		menu.hidden = true;
		toggleBtn.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
	}

	toggleBtn.addEventListener("click", openMenu);
	closeBtn.addEventListener("click", closeMenu);
	menuLinks.forEach((link) => link.addEventListener("click", closeMenu));
</script>

<script>
	// Scrollspy: highlight the nav link whose section is currently in view.
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
	const sections = [...new Set(navLinks.map((l) => l.dataset.navLink!))]
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null)
		.sort((a, b) => a.offsetTop - b.offsetTop);

	const LINE = 100; // px below the viewport top (clears the sticky navbar)

	function updateActive() {
		let currentId: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top - LINE <= 0) currentId = section.id;
		}
		for (const link of navLinks) {
			link.classList.toggle("is-active", link.dataset.navLink === currentId);
		}
	}

	let ticking = false;
	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateActive();
			ticking = false;
		});
	}

	if (sections.length) {
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		updateActive();
	}
</script>
