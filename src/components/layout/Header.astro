---
import BrandLockup from "../ui/BrandLockup.astro";
import Button from "../ui/Button.astro";

const navLinks = [
	{ id: "uslugi", label: "Usługi" },
	{ id: "o-mnie", label: "O mnie" },
	{ id: "cennik", label: "Cennik" },
	{ id: "faq", label: "FAQ" },
];

// Sekcje istnieją tylko na stronie głównej. Na podstronach (np. polityce
// prywatności) gołe `#uslugi` nie prowadziłoby donikąd, więc kotwice dostają
// prefiks ścieżki. `data-nav-link` zostaje samym id — scrollspy niżej opiera
// się na nim i prefiks by go rozstroił.
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---



<header class="sticky top-0 z-60">
	<nav
		class="flex items-center justify-between px-[clamp(18px,4vw,56px)] py-3.5 bg-bg/78 backdrop-blur-xl border-b border-black/6"
	>
		<BrandLockup href={isHome ? "#top" : "/"} size="lg" />

		<div class="hidden md:flex items-center gap-4.5 lg:gap-7.5">
			{
				navLinks.map((link) => (
					<a
						href={anchor(link.id)}
						data-nav-link={link.id}
						class="nav-link nav-underline text-[14.5px] font-semibold text-muted-700 transition-colors duration-200 hover:text-ink"
					>
						{link.label}
					</a>
				))
			}
			<Button href={anchor("kontakt")} variant="nav">Bezpłatna konsultacja</Button>
		</div>

		<button
			id="menu-toggle"
			aria-label="Menu"
			aria-expanded="false"
			aria-controls="mobile-drawer"
			class="grid h-11 w-11 place-items-center rounded-xl bg-surface-2 md:hidden"
		>
			<span class="burger" aria-hidden="true">
				<span class="burger-line"></span>
				<span class="burger-line"></span>
				<span class="burger-line"></span>
			</span>
		</button>
	</nav>

	<div id="mobile-drawer" class="drawer md:hidden" aria-hidden="true" inert>
		<div class="drawer-inner">
			<nav class="flex flex-col gap-1.5 px-[clamp(18px,4vw,56px)] pt-2" aria-label="Menu mobilne">
				{
					navLinks.map((link, i) => (
						<a
							href={anchor(link.id)}
							data-menu-link
							data-nav-link={link.id}
							style={`--i:${i}`}
							class="drawer-link nav-link border-b border-border py-3 font-display text-[30px] font-bold text-ink"
						>
							{link.label}
						</a>
					))
				}
				<a
					href={anchor("kontakt")}
					data-menu-link
					style={`--i:${navLinks.length}`}
					class="drawer-link mt-2 mb-6 flex h-14 items-center justify-center rounded-2xl bg-linear-to-br from-accent to-accent-2 text-[17px] font-bold text-white shadow-[0_16px_30px_-14px_rgba(47,68,104,0.5)]"
				>
					Umów bezpłatną konsultację
				</a>
			</nav>
		</div>
	</div>
</header>

<div id="menu-backdrop" class="drawer-backdrop fixed inset-0 z-58 bg-black/40 md:hidden" aria-hidden="true">
</div>

<script>
	const toggleBtn = document.getElementById("menu-toggle")!;
	const drawer = document.getElementById("mobile-drawer")!;
	const backdrop = document.getElementById("menu-backdrop")!;
	const menuLinks = drawer.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");
	let isOpen = false;

	function openMenu() {
		isOpen = true;
		drawer.inert = false;
		drawer.removeAttribute("aria-hidden");
		drawer.classList.add("is-open");
		backdrop.classList.add("is-open");
		toggleBtn.setAttribute("aria-expanded", "true");
		document.body.style.overflow = "hidden";
		menuLinks[0]?.focus();
	}

	// `transitionend` bubbles up from the `.drawer-link` children (their own
	// opacity/transform transitions), so a naive `{ once: true }` listener on
	// `drawer` would consume itself on the first child event instead of
	// waiting for the drawer's own `grid-template-rows` transition to finish.
	// Filtering by target+property and removing the listener manually avoids
	// that, while the same function reference makes repeat `addEventListener`
	// calls (rapid close/close) a safe no-op.
	function onDrawerCollapsed(e: TransitionEvent) {
		if (e.target !== drawer || e.propertyName !== "grid-template-rows" || isOpen) return;
		drawer.inert = true;
		drawer.setAttribute("aria-hidden", "true");
		drawer.removeEventListener("transitionend", onDrawerCollapsed);
	}

	function closeMenu({ returnFocus = true }: { returnFocus?: boolean } = {}) {
		if (!isOpen) return;
		isOpen = false;
		drawer.classList.remove("is-open");
		backdrop.classList.remove("is-open");
		toggleBtn.setAttribute("aria-expanded", "false");
		document.body.style.overflow = "";
		if (returnFocus) toggleBtn.focus();
		drawer.addEventListener("transitionend", onDrawerCollapsed);
	}

	toggleBtn.addEventListener("click", () => (isOpen ? closeMenu() : openMenu()));
	backdrop.addEventListener("click", () => closeMenu());
	menuLinks.forEach((link) =>
		link.addEventListener("click", () => closeMenu({ returnFocus: false })),
	);
	document.addEventListener("keydown", (e) => {
		if (e.key === "Escape" && isOpen) closeMenu();
	});
</script>

<script>
	// Scrollspy: highlight the nav link whose section is currently in view.
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
	const sections = [...new Set(navLinks.map((l) => l.dataset.navLink!))]
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null)
		.sort((a, b) => a.offsetTop - b.offsetTop);

	const LINE = 100; // px below the viewport top (clears the sticky navbar)

	function updateActive() {
		let currentId: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top - LINE <= 0) currentId = section.id;
		}
		for (const link of navLinks) {
			link.classList.toggle("is-active", link.dataset.navLink === currentId);
		}
	}

	let ticking = false;
	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateActive();
			ticking = false;
		});
	}

	if (sections.length) {
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		updateActive();
	}
</script>

<!-- Pasek celowo NIE zmienia wysokości przy zwijaniu logotypu. `nav` jest
     `sticky`, więc nadal zajmuje miejsce w flow — każda zmiana jego wysokości
     przepycha w trakcie scrolla całą treść pod spodem. Litery logotypu chowają
     się wewnątrz stałej wysokości paska. -->
