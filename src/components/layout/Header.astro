---
import BrandLockup from "../ui/BrandLockup.astro";
import Button from "../ui/Button.astro";

const navLinks = [
	{ id: "uslugi", label: "Usługi" },
	{ id: "o-mnie", label: "O mnie" },
	{ id: "cennik", label: "Cennik" },
	{ id: "faq", label: "FAQ" },
];

// Sekcje istnieją tylko na stronie głównej. Na podstronach (np. polityce
// prywatności) gołe `#uslugi` nie prowadziłoby donikąd, więc kotwice dostają
// prefiks ścieżki. `data-nav-link` zostaje samym id — scrollspy niżej opiera
// się na nim i prefiks by go rozstroił.
const isHome = Astro.url.pathname === "/";
const anchor = (id: string) => (isHome ? `#${id}` : `/#${id}`);
---



<nav
	class="sticky top-0 z-60 flex items-center justify-between px-[clamp(18px,4vw,56px)] py-3.5 bg-bg/78 backdrop-blur-xl border-b border-black/6"
>
	<BrandLockup href={isHome ? "#top" : "/"} size="lg" />

	<div class="hidden md:flex items-center gap-4.5 lg:gap-7.5">
		{
			navLinks.map((link) => (
				<a
					href={anchor(link.id)}
					data-nav-link={link.id}
					class="nav-link nav-underline text-[14.5px] font-semibold text-muted-700 transition-colors duration-200 hover:text-ink"
				>
					{link.label}
				</a>
			))
		}
		<Button href={anchor("kontakt")} variant="nav">Bezpłatna konsultacja</Button>
	</div>

	<button
		id="menu-toggle"
		aria-label="Menu"
		aria-expanded="false"
		aria-controls="mobile-menu"
		class="hamburger grid h-11 w-11 place-items-center rounded-xl bg-[#F1F2F7] md:hidden"
	>
		<span class="hamburger-icon">
			<span class="hamburger-line"></span>
			<span class="hamburger-line"></span>
			<span class="hamburger-line"></span>
		</span>
	</button>

	<div id="mobile-menu" aria-hidden="true" class="absolute inset-x-0 top-full md:hidden">
		<div class="overflow-hidden">
			<div class="mx-3.5 mt-2 mb-4 rounded-2xl border border-border bg-bg p-4 shadow-[0_20px_40px_-18px_rgba(20,22,40,0.35)]">
				<div class="flex flex-col gap-1.5">
					{
						navLinks.map((link) => (
							<a
								href={anchor(link.id)}
								data-menu-link
								data-nav-link={link.id}
									class="nav-link border-b border-border py-3 font-display text-[26px] font-bold text-ink"
							>
								{link.label}
							</a>
						))
					}
				</div>
				<a
					href={anchor("kontakt")}
					data-menu-link
					class="mt-4 flex h-14 items-center justify-center rounded-2xl bg-linear-to-br from-accent to-accent-2 text-[17px] font-bold text-white shadow-[0_16px_30px_-14px_rgba(79,91,242,0.8)]"
				>
					Umów bezpłatną konsultację
				</a>
			</div>
		</div>
	</div>
</nav>

<script>
	const toggleBtn = document.getElementById("menu-toggle")!;
	const menu = document.getElementById("mobile-menu")!;
	const menuLinks = menu.querySelectorAll<HTMLAnchorElement>("[data-menu-link]");

	function isOpen() {
		return toggleBtn.classList.contains("is-open");
	}

	function openMenu() {
		toggleBtn.classList.add("is-open");
		menu.classList.add("is-open");
		toggleBtn.setAttribute("aria-expanded", "true");
		menu.setAttribute("aria-hidden", "false");
		document.body.style.overflow = "hidden";
		menuLinks[0]?.focus({ preventScroll: true });
	}

	function closeMenu() {
		toggleBtn.classList.remove("is-open");
		menu.classList.remove("is-open");
		toggleBtn.setAttribute("aria-expanded", "false");
		menu.setAttribute("aria-hidden", "true");
		document.body.style.overflow = "";
	}

	function toggleMenu() {
		if (isOpen()) {
			closeMenu();
		} else {
			openMenu();
		}
	}

	toggleBtn.addEventListener("click", toggleMenu);
	menuLinks.forEach((link) => link.addEventListener("click", closeMenu));

	document.addEventListener("keydown", (event) => {
		if (event.key === "Escape" && isOpen()) {
			closeMenu();
			toggleBtn.focus({ preventScroll: true });
		}
	});

	document.addEventListener("pointerdown", (event) => {
		if (!isOpen()) return;
		const target = event.target as Node;
		if (menu.contains(target) || toggleBtn.contains(target)) return;
		closeMenu();
	});
</script>

<script>
	// Scrollspy: highlight the nav link whose section is currently in view.
	const navLinks = Array.from(document.querySelectorAll<HTMLAnchorElement>("[data-nav-link]"));
	const sections = [...new Set(navLinks.map((l) => l.dataset.navLink!))]
		.map((id) => document.getElementById(id))
		.filter((el): el is HTMLElement => el !== null)
		.sort((a, b) => a.offsetTop - b.offsetTop);

	const LINE = 100; // px below the viewport top (clears the sticky navbar)

	function updateActive() {
		let currentId: string | null = null;
		for (const section of sections) {
			if (section.getBoundingClientRect().top - LINE <= 0) currentId = section.id;
		}
		for (const link of navLinks) {
			link.classList.toggle("is-active", link.dataset.navLink === currentId);
		}
	}

	let ticking = false;
	function onScroll() {
		if (ticking) return;
		ticking = true;
		requestAnimationFrame(() => {
			updateActive();
			ticking = false;
		});
	}

	if (sections.length) {
		window.addEventListener("scroll", onScroll, { passive: true });
		window.addEventListener("resize", onScroll);
		updateActive();
	}
</script>

<!-- Pasek celowo NIE zmienia wysokości przy zwijaniu logotypu. `nav` jest
     `sticky`, więc nadal zajmuje miejsce w flow — każda zmiana jego wysokości
     przepycha w trakcie scrolla całą treść pod spodem. Litery logotypu chowają
     się wewnątrz stałej wysokości paska. -->
