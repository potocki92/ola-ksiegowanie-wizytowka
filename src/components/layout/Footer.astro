---
import BrandLockup from "../ui/BrandLockup.astro";
import {
	company,
	companyAddressLine,
	companyNipFormatted,
} from "../../data/company";

const year = new Date().getFullYear();
---

<footer
	class="border-t border-border-2 px-[clamp(18px,4vw,56px)] py-[clamp(32px,4vw,52px)] pb-[calc(clamp(32px,4vw,52px)+92px)] md:pb-[clamp(32px,4vw,52px)]"
>
	<div
		class="mx-auto flex max-w-305 flex-col gap-8 md:flex-row md:items-start md:justify-between"
	>
		<div class="flex flex-col gap-3">
			<BrandLockup animated={false} size="sm" />
			<address class="text-[13px] leading-relaxed text-muted-300 not-italic">
				Usługi świadczy {company.legal.name}<br />
				{companyAddressLine}<br />
				NIP: {companyNipFormatted}
			</address>
		</div>

		<div
			class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] font-medium text-muted-300 md:justify-end"
		>
			<a
				href="/polityka-prywatnosci"
				class="text-muted-300 transition-colors duration-200 hover:text-ink"
			>
				Polityka prywatności
			</a>
			<span>© {year} · Księgowość online w całej Polsce</span>
		</div>
	</div>
</footer>
