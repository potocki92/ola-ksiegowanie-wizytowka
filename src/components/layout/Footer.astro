---
import Logo from "../ui/Logo.astro";

const year = new Date().getFullYear();
---

<footer class="px-[clamp(18px,4vw,56px)] py-[clamp(32px,4vw,52px)] pb-[calc(clamp(32px,4vw,52px)+92px)] md:pb-[clamp(32px,4vw,52px)]">
	<div
		class="mx-auto flex max-w-305 flex-wrap items-center justify-between gap-18 border-t border-border-2 pt-[clamp(28px,3vw,40px)]"
	>
		<Logo size="sm" name="Aleksandra Potocka · Księgowość" />
		<div class="text-[13px] font-medium text-muted-300">
			© {year} · Księgowość online w całej Polsce
		</div>
	</div>
</footer>
