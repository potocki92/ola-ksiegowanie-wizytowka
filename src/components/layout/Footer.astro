---
import BrandLockup from "../ui/BrandLockup.astro";

const year = new Date().getFullYear();
---

<footer class="border-t border-border-2 px-[clamp(18px,4vw,56px)] py-[clamp(32px,4vw,52px)] pb-[calc(clamp(32px,4vw,52px)+92px)] md:pb-[clamp(32px,4vw,52px)]">
	<div
		class="mx-auto flex max-w-305 flex-wrap items-center justify-between gap-18"
	>
		<BrandLockup animated={false} size="sm" />
		<div
			class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] font-medium text-muted-300"
		>
			<a
				href="/polityka-prywatnosci"
				class="text-muted-300 transition-colors duration-200 hover:text-ink"
			>
				Polityka prywatności
			</a>
			<span>© {year} · Księgowość online w całej Polsce</span>
		</div>
	</div>
</footer>
