---
interface Props {
	variant?: "primary" | "secondary" | "inverse" | "nav";
	size?: "md" | "lg";
	href?: string;
	type?: "button" | "submit";
	class?: string;
	[key: string]: unknown;
}

const {
	variant = "primary",
	size = "md",
	href,
	type = "button",
	class: className,
	...rest
} = Astro.props;

const base = "inline-flex items-center justify-center font-bold transition-all duration-200";

const sizeClass = {
	md: "h-13 gap-2.5 rounded-2xl px-7 text-[15px]",
	lg: "h-14 gap-2.5 rounded-2xl px-7 text-base",
}[size];

const variantClass = {
	primary:
		"bg-linear-to-br from-accent to-accent-2 text-white shadow-[0_18px_34px_-14px_rgba(79,91,242,0.75)] hover:-translate-y-0.5 hover:shadow-[0_24px_44px_-14px_rgba(79,91,242,0.85)]",
	secondary: "border border-border-3 bg-white text-ink hover:-translate-y-0.5",
	inverse: "bg-white text-muted-900 hover:-translate-y-0.5",
	nav: "h-[42px] rounded-full bg-ink px-5 text-sm font-semibold text-white hover:-translate-y-px",
}[variant];

const classes = ["primary", "secondary", "inverse"].includes(variant)
	? [base, sizeClass, variantClass, className]
	: [base, variantClass, className];
---

{
	href ? (
		<a href={href} class:list={classes} {...rest}>
			<slot />
		</a>
	) : (
		<button type={type} class:list={classes} {...rest}>
			<slot />
		</button>
	)
}
