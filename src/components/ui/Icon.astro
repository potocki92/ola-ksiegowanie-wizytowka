---
export type IconName =
	| "menu"
	| "close"
	| "check"
	| "briefcase"
	| "plus"
	| "user"
	| "users"
	| "chat"
	| "check-circle"
	| "cloud"
	| "calendar-check"
	| "phone"
	| "mail"
	| "map-pin"
	| "file-text"
	| "chevron-down"
	| "employee-file"
	| "business-start"
	| "tax-calculator"
	| "ledger-check"
	| "user";

interface Props {
	name: IconName;
	size?: number;
	strokeWidth?: number;
	class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{
		name === "menu" && <path d="M3 6h18M3 12h18M3 18h18" />
	}
	{
		name === "close" && <path d="M6 6l12 12M18 6L6 18" />
	}
	{
		name === "check" && <path d="M20 6 9 17l-5-5" />
	}
	{
		name === "briefcase" && (
			<>
				<path d="M9 2h6l4 4v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
				<path d="M14 2v4h4M8 13h8M8 17h5" />
			</>
		)
	}
	{
		name === "plus" && <path d="M12 5v14M5 12h14" />
	}
	{
		name === "user" && (
			<>
				<circle cx="12" cy="8" r="3.6" />
				<path d="M5 20.5a7 7 0 0 1 14 0" />
			</>
		)
	}
	{
		name === "users" && (
			<>
