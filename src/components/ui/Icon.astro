---
export type IconName =
	| "menu"
	| "close"
	| "check"
	| "briefcase"
	| "plus"
	| "user"
	| "users"
	| "chat"
	| "check-circle"
	| "cloud"
	| "calendar-check"
	| "phone"
	| "mail"
	| "map-pin"
	| "file-text"
	| "chevron-down"
	| "user";

interface Props {
	name: IconName;
	size?: number;
	strokeWidth?: number;
	class?: string;
}

const { name, size = 24, strokeWidth = 2, class: className } = Astro.props;
---

<svg
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width={strokeWidth}
	stroke-linecap="round"
	stroke-linejoin="round"
	class={className}
	aria-hidden="true"
>
	{
		name === "menu" && <path d="M3 6h18M3 12h18M3 18h18" />
	}
	{
		name === "close" && <path d="M6 6l12 12M18 6L6 18" />
	}
	{
		name === "check" && <path d="M20 6 9 17l-5-5" />
	}
	{
		name === "briefcase" && (
			<>
				<path d="M9 2h6l4 4v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z" />
				<path d="M14 2v4h4M8 13h8M8 17h5" />
			</>
		)
	}
	{
		name === "plus" && <path d="M12 5v14M5 12h14" />
	}
	{
		name === "user" && (
			<>
				<circle cx="12" cy="8" r="3.6" />
				<path d="M5 20.5a7 7 0 0 1 14 0" />
			</>
		)
	}
	{
		name === "users" && (
			<>
				<circle cx="9" cy="8" r="3.2" />
				<path d="M3.5 20a5.5 5.5 0 0 1 11 0M16 8h5M16 12h5M16 16h3" />
			</>
		)
	}
	{
		name === "chat" && <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z" />
	}
	{
		name === "check-circle" && (
			<>
				<path d="M12 2a10 10 0 1 0 10 10" />
				<path d="m9 11 3 3 8-8" />
			</>
		)
	}
	{
		name === "cloud" && (
			<path d="M4 7a8 4 0 0 0 16 0M4 7a8 4 0 0 1 16 0v10a8 4 0 0 1-16 0zM4 12a8 4 0 0 0 16 0" />
		)
	}
	{
		name === "calendar-check" && (
			<>
				<rect x="3" y="4" width="18" height="18" rx="3" />
				<path d="M16 2v4M8 2v4M3 10h18" />
			</>
		)
	}
	{
		name === "phone" && (
			<path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3 19.5 19.5 0 0 1-6-6 19.8 19.8 0 0 1-3-8.6A2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.6a2 2 0 0 1-.5 2.1L8 9.5a16 16 0 0 0 6 6l1.1-1.1a2 2 0 0 1 2.1-.5c.8.3 1.7.5 2.6.6a2 2 0 0 1 1.7 2z" />
		)
	}
	{
		name === "mail" && (
			<>
				<rect x="2" y="4" width="20" height="16" rx="2" />
				<path d="m2 6 10 7L22 6" />
			</>
		)
	}
	{
		name === "map-pin" && (
			<>
				<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z" />
				<circle cx="12" cy="10" r="3" />
			</>
		)
	}
	{
		name === "file-text" && (
			<>
				<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
				<path d="M14 2v6h6M8 13h8M8 17h6" />
			</>
		)
	}
	{
		name === "chevron-down" && <path d="m6 9 6 6 6-6" />
	}
</svg>
