		)
	}
	{
		name === "tax-calculator" && (
			<>
				<path d="M17 10.5V6.5l-4-4H4.5a1 1 0 0 0-1 1v17a1 1 0 0 0 1 1h6.3" />
				<path d="M13 2.5v4h4M6.5 9h5M6.5 11.4h4.5M6.5 13.8h3" />
				<rect x="13" y="12.5" width="9" height="9" rx="2.2" />
