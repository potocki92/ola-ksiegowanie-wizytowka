---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "../Icon.astro";

interface Props extends HTMLAttributes<"textarea"> {
	icon?: IconName;
}

const {
	icon,
	class: className,
	...attrs
} = Astro.props;
---

<span class="relative block">
	{
		icon && (
			<Icon
				name={icon}
				size={18}
				strokeWidth={1.9}
				class="pointer-events-none absolute top-2.5 left-4 text-muted-50"
			/>
		)
	}

	<textarea
		{...attrs}
		class:list={[
			"min-h-32 w-full resize-y rounded-xl border border-white/18 bg-white/6 py-2 pr-4 font-[inherit] text-[15px] text-white outline-none transition-[border-color,box-shadow] duration-200",
			icon ? "pl-11" : "pl-4",
			className,
		]}
	/>
</span>
