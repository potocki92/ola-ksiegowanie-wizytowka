---
import type { HTMLAttributes } from "astro/types";
import type { IconName } from "../Icon.astro";
import FormField from "./FormField.astro";
import Input from "./Input.astro";

interface Props extends HTMLAttributes<"input"> {
	label: string;
	name: string;
	icon?: IconName;
	hint?: string;
}

const {
	label,
	name,
	icon,
	hint,
	id = name,
	required = false,
	class: className,
	...attrs
} = Astro.props;

// `id`/`required` przychodzą z HTMLAttributes jako typy atrybutów HTML,
// a FormField oczekuje wartości znormalizowanych.
const fieldId = id ?? name;
const isRequired = Boolean(required);
const hintId = hint ? `${fieldId}-hint` : undefined;
---

<FormField
	label={label}
	for={fieldId}
	required={isRequired}
	hint={hint}
	hintId={hintId}
	class={className}
>
	<Input
		id={fieldId}
		name={name}
		icon={icon}
		required={isRequired}
		aria-describedby={hintId}
		{...attrs}
	/>
</FormField>
