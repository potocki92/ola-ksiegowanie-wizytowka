---
import type { HTMLAttributes } from "astro/types";
import type { IconName } from "../Icon.astro";
import FormField from "./FormField.astro";
import Input from "./Input.astro";

interface Props extends HTMLAttributes<"input"> {
	label: string;
	name: string;
	icon?: IconName;
}

const {
	label,
	name,
	icon,
	id = name,
	required = false,
	class: className,
	...attrs
} = Astro.props;

// `id`/`required` przychodzą z HTMLAttributes jako typy atrybutów HTML,
// a FormField oczekuje wartości znormalizowanych.
const fieldId = id ?? name;
const isRequired = Boolean(required);
---

<FormField label={label} for={fieldId} required={isRequired} class={className}>
	<Input
		id={fieldId}
		name={name}
		icon={icon}
		required={isRequired}
		{...attrs}
	/>
</FormField>
