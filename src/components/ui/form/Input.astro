---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "../Icon.astro";

interface Props extends HTMLAttributes<"input"> {
	icon?: IconName;
}

const {
	icon,
	class: className,
	...attrs
} = Astro.props;
---

<span class="relative block">
	{
		icon && (
			<Icon
				name={icon}
				size={18}
				strokeWidth={1.9}
				class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted-50"
			/>
		)
	}

	<input
		{...attrs}
		class:list={[
			"h-12.5 w-full rounded-xl border border-white/18 bg-white/6 pr-4 font-[inherit] text-[15px] text-white outline-none transition-[border-color,box-shadow] duration-200",
			icon ? "pl-11" : "pl-4",
			className,
		]}
	/>
</span>
