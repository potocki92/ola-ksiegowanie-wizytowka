---
import type { HTMLAttributes } from "astro/types";
import Label from "./Label.astro";

interface Props extends HTMLAttributes<"label"> {
	label: string;
	for: string;
	required?: boolean;
	/** Podpowiedź pod polem. Kontrolkę z nią wiąże `aria-describedby={hintId}`. */
	hint?: string;
	hintId?: string;
}

const {
	label,
	for: htmlFor,
	required = false,
	hint,
	hintId,
	class: className,
	...attrs
} = Astro.props;
---

<Label for={htmlFor} class={className} {...attrs}>
	<span class="text-[13px] font-semibold text-white/80">
		{label}

		{
			required && (
				<span class="text-accent-soft" aria-hidden="true">
					{" *"}
				</span>
			)
		}
	</span>

	<slot />

	{
		hint && (
			<span
				data-form-hint
				id={hintId}
				class="text-[12.5px] leading-relaxed text-white/50"
			>
				{hint}
			</span>
		)
	}
</Label>
