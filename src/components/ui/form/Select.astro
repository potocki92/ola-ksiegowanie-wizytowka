---
import type { HTMLAttributes } from "astro/types";
import Icon, { type IconName } from "../Icon.astro";

export interface Option {
	value: string;
	label: string;
}

interface Props extends HTMLAttributes<"select"> {
	icon?: IconName;
	/** Lista opcji. Gdy jej nie podasz, opcje przekazujesz przez slot. */
	options?: Option[];
	placeholder?: string;
}

const {
	icon,
	options,
	placeholder,
	class: className,
	...attrs
} = Astro.props;
---

<span class="relative block">
	{
		icon && (
			<Icon
				name={icon}
				size={18}
				strokeWidth={1.9}
				class="pointer-events-none absolute top-1/2 left-4 -translate-y-1/2 text-muted-50"
			/>
		)
	}

	<select
		{...attrs}
		class:list={[
			"h-12.5 w-full appearance-none rounded-xl border border-white/18 bg-white/6 pr-11 font-[inherit] text-[16px] text-white outline-none transition-[border-color,box-shadow] duration-200",
			"[&_option]:bg-[#171a2e] [&_option]:text-white",
			icon ? "pl-11" : "pl-4",
			className,
		]}
	>
		{placeholder && <option value="">{placeholder}</option>}
		{options ? options.map((option) => <option value={option.value}>{option.label}</option>) : <slot />}
	</select>

	<Icon
		name="chevron-down"
		size={18}
		strokeWidth={1.9}
		class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-muted-50"
	/>
</span>
