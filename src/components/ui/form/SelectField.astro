---
import type { HTMLAttributes } from "astro/types";
import type { IconName } from "../Icon.astro";
import FormField from "./FormField.astro";
import Select from "./Select.astro";

interface Props extends HTMLAttributes<"select"> {
	label: string;
	name: string;
	icon?: IconName;
	hint?: string;
	/** Opcje selecta; pierwszy `<option>` to zawsze placeholder „Wybierz…". */
	options: ReadonlyArray<{ value: string; label: string }>;
}

const {
	label,
	name,
	icon,
	hint,
	options,
	id = name,
	required = false,
	class: className,
	...attrs
} = Astro.props;

// `id`/`required` przychodzą z HTMLAttributes jako typy atrybutów HTML,
// a FormField oczekuje wartości znormalizowanych.
const fieldId = id ?? name;
const isRequired = Boolean(required);
const hintId = hint ? `${fieldId}-hint` : undefined;
---

<FormField
	label={label}
	for={fieldId}
	required={isRequired}
	hint={hint}
	hintId={hintId}
	class={className}
>
	<Select
		id={fieldId}
		name={name}
		icon={icon}
		required={isRequired}
		aria-describedby={hintId}
		{...attrs}
	>
		<option value="" selected disabled>Wybierz…</option>
		{options.map((option) => <option value={option.value}>{option.label}</option>)}
	</Select>
</FormField>
