---
import { Image } from "astro:assets";
// Import z `src/assets`, nie ścieżka z `public/` — tylko wtedy Astro przepuści
// plik przez sharp i wygeneruje WebP w gęstościach 2× i 3×. Poprzednie
// `/logo.svg` było PNG-iem owiniętym w `<mask>` + `<filter>`; taki węzeł ląduje
// w buforze offscreen, który mobilne przeglądarki rasteryzują w obniżonej
// rozdzielczości — stąd rozmyty znaczek na telefonie.
import logoSrc from "../../assets/logo.png";

interface Props {
	size?: "sm" | "md" | "lg";
	class?: string;
}

const { size = "lg", class: className } = Astro.props;
---

<span class:list={["logo-mark", `is-${size}`, className]}>
	{/* Największy wariant to 40 px — `densities` daje z tego 80 i 120 px na
	    ekranach o wyższym DPR. `eager`, bo znaczek jest nad zgięciem na każdej
	    podstronie i domyślne `lazy` tylko opóźniałoby jego pojawienie się. */}
	<Image src={logoSrc} alt="" width={40} height={40} densities={[2, 3]} loading="eager" />
</span>

<style>
	/* Bok znaczka jedzie przez zmienną, żeby BrandLockup mógł go zmniejszyć
	   przy zwijaniu nagłówka. Wartość z klasy `is-*` przegrywa z regułą
	   potomka w BrandLockup — i o to chodzi. */
	.logo-mark {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: var(--logo-mark, 38px);
		height: var(--logo-mark, 38px);
		transition:
			width 0.25s ease,
			height 0.25s ease;
	}
	.logo-mark.is-sm {
		--logo-mark: 34px;
	}
	.logo-mark.is-md {
		--logo-mark: 38px;
	}
	.logo-mark.is-lg {
		--logo-mark: 40px;
	}

	.logo-mark img {
		width: 100%;
		height: 100%;
	}
</style>
