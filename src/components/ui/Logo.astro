---
import { Image } from "astro:assets";

interface Props {
	size?: "sm" | "md" | "lg";
	class?: string;
}

const { size = "lg", class: className } = Astro.props;
---

<span class:list={["logo-mark", `is-${size}`, className]}>
	<Image src="/logo.svg" alt="" width={100} height={100} />
</span>

<style>
	/* Bok znaczka jedzie przez zmienną, żeby BrandLockup mógł go zmniejszyć
	   przy zwijaniu nagłówka. Wartość z klasy `is-*` przegrywa z regułą
	   potomka w BrandLockup — i o to chodzi. */
	.logo-mark {
		display: grid;
		place-items: center;
		flex: 0 0 auto;
		width: var(--logo-mark, 38px);
		height: var(--logo-mark, 38px);
		transition:
			width 0.25s ease,
			height 0.25s ease;
	}
	.logo-mark.is-sm {
		--logo-mark: 34px;
	}
	.logo-mark.is-md {
		--logo-mark: 38px;
	}
	.logo-mark.is-lg {
		--logo-mark: 40px;
	}

	.logo-mark img {
		width: 100%;
		height: 100%;
	}
</style>
